__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ---- Node / Frontend ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
frontend/.env
frontend/.env.*
!frontend/.env.example

# ---- Env / Secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

