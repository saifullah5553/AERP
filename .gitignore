# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ---- Node / Frontend ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
frontend/.env
frontend/.env.*
!frontend/.env.example

# ---- Env / Secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Local Claude Code settings (machine-specific) ----
.claude/settings.local.json

# ---- Data / Logs ----
*.log
*.sqlite3
*.db
pgdata/
redisdata/
/backend/.data/
# Local market data (PSX CSVs, etc.) — large, not versioned. Keep the folder.
/data/*
!/data/psx_csv/
/data/psx_csv/*
!/data/psx_csv/.gitkeep
# ...but DO version the compressed PSX inputs so the free CI refresh is self-contained.
!/data/psx_csv.tar.gz
!/data/psx_insider.csv
# Scraped fundamentals: the raw per-company CSVs (~45k files, ~300MB) stay local as the source
# of truth. What ships is the distilled store - an order of magnitude smaller, holding only the
# metrics the engines read - so CI stays self-contained without carrying dead line items.
!/data/fundamentals_ttm/
!/data/fundamentals_ttm/*.json.gz
# The listed-company lists are the universe definition, small and worth versioning - CI must
# not have to scrape to know which companies exist.
!/data/universe/
!/data/universe/*.csv
# The symbol registry reconciles the exchange, Yahoo and stockanalysis spellings of every
# company. Small, and versioned deliberately: a mismatch should show up as a reviewable diff,
# not as an unexplained gap months later.
!/data/symbols/
!/data/symbols/*.csv
# Each scraper writes its CSVs next to itself. Same rule as the market folders above: the raw
# downloads stay local, only the distilled store is versioned.
/scripts/market_scrapers/*_data/
# Symbols with no financial statements at the source. export-static applies these, so CI needs
# them: unversioned, every refresh silently re-adds the 955 funds, SPACs and dead tickers we
# just removed. A deletion that does not survive the next rebuild is not a deletion.
!/data/exclusions/
!/data/exclusions/*.txt
# Resolved sectors, versioned so no run ever re-derives them from an external service. A sector
# changes about never; re-fetching it every time was a dependency we did not need.
!/data/sectors/
!/data/sectors/*.csv
# Our own accumulated daily OHLC is the opposite - hundreds of MB and growing every day, so it
# stays local. Yahoo serves a rolling window, which is exactly why we keep our own copy.
/data/ohlc/
# ...but DO version the close-only pack built from it. 1.1 GB of per-symbol CSVs
# cannot be committed; ~45 MB of gzipped closes can, and without them CI cannot
# price a single company - which rebuilt every quarterly history as zero trades.
!/data/prices/
!/data/prices/*.json.gz
data/fund_cache/

data/earnings_refresh.log
data/fundamentals_batch.log
data/sector_cache.json

# Held while a writer has the snapshot open. Runtime state, never versioned - a committed
# lock makes every later run think another writer is active.
/frontend/public/data/.snapshot.lock

# The scraped CSVs now live in the REPO ROOT rather than the Windows user profile. Same rule as
# always - ~270 MB of raw downloads stay local, only the distilled store is versioned - but the
# existing pattern only covered scripts/market_scrapers/*_data, so a git add -A swept 37,996
# files into a commit. Caught before it was pushed.
/us_data/
/india_data/
/australia_data/
/tadawul_data/
/dfm_data/
/psx_raw_data/
/*_data/
Stock Analysis CSV Data*.py
