{"security": {"id": 828, "market_id": 2, "symbol": "ABT", "provider_symbol": "ABT", "name": "Abbott Laboratories", "asset_class": "equity", "sector": "Health Care", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000001800", "long_business_summary": "Abbott Laboratories, together with its subsidiaries, discovers, develops, manufactures, and sells health care products worldwide. It operates in four segments: Established Pharmaceutical Products, Diagnostic Products, Nutritional Products, and Medical Devices. The company offers generic pharmaceuticals for the treatment of pancreatic exocrine insufficiency, irritable bowel syndrome or biliary spasm, intrahepatic cholestasis or depressive symptoms, gynecological disorder, hormone replacement therapy, dyslipidemia, hypertension, hypothyroidism, hypertriglyceridemia, Ménière's disease and vestibular vertigo, pain, fever, inflammation, and migraine, as well as provides anti-infective clarithromycin, influenza vaccine, and products to regulate physiological rhythm of the colon. It also provides laboratory and transfusion medicine systems in the areas of immunoassay, clinical chemistry, hematology, and transfusion serology testing; molecular diagnostics polymerase chain reaction instrument systems that automate the extraction, purification, and preparation of DNA and RNA from patient samples, and detect and measure infectious agents; point of care systems; cartridges for testing blood gas, chemistry, electrolytes, coagulation, and immunoassay; rapid diagnostics lateral flow testing products; molecular point-of-care testing for HIV, SARS-CoV-2, influenza A and B, RSV, and strep A; cardiometabolic test systems; and drug and alcohol test. In addition, the company offers pediatric and adult nutritional products and infant formula; rhythm management, electrophysiology, heart failure, vascular, and structural heart devices for the treatment of cardiovascular diseases; diabetes care products, such as glucose and blood glucose monitoring systems; and neuromodulation devices. The company was formerly known as Abbott Alkaloidal Company and changed its name to Abbott Laboratories in 1915. Abbott Laboratories was founded in 1888 and is based in Abbott Park, Illinois.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-14", "eps_estimate_avg": 1.41767, "eps_estimate_num": 22, "eps_estimate_growth": 0.0905, "eps_estimate_fwd": 6.06458, "revenue_estimate_avg": 12993155500.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:ABT", "quote": {"security_id": 828, "price": 105.99, "prev_close": 105.61, "change": 0.38, "change_pct": 0.359814, "day_open": 101.5, "day_high": 106.1, "day_low": 102.89, "volume": 5101081, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 358, "security_id": 828, "as_of": "2026-07-27", "fundamental": 65.66, "technical": 73.06, "momentum": 76.27, "quality": 70.79, "risk": 71.32, "composite": 71.08, "pabrai": 64.1, "breakdown": {"fundamental": {"score": 65.66, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.130749, "sub_score": 52.3, "weight": 0.14, "contribution": 7.322}, "net_margin": {"label": "Net margin", "value": 0.147176, "sub_score": 73.59, "weight": 0.1, "contribution": 7.359}, "roa": {"label": "Return on assets", "value": 0.077608, "sub_score": 64.67, "weight": 0.08, "contribution": 5.1736}, "gross_margin": {"label": "Gross margin", "value": 0.564181, "sub_score": 94.03, "weight": 0.06, "contribution": 5.6418}, "revenue_growth": {"label": "Revenue growth", "value": 0.056687, "sub_score": 44.77, "weight": 0.1, "contribution": 4.477}, "eps_growth": {"label": "EPS growth", "value": -0.514581, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.265874, "sub_score": 89.37, "weight": 0.1, "contri