{"security": {"id": 1016, "market_id": 5, "symbol": "HINDALCO", "provider_symbol": "HINDALCO.NS", "name": "Hindalco Industries", "asset_class": "equity", "sector": "Materials", "industry": null, "currency": "INR", "country": "IN", "isin": null, "figi": null, "cik": null, "long_business_summary": "Hindalco Industries Limited, together with its subsidiaries, manufactures and distributes aluminum and copper products in India and internationally. It operates through four segments: Novelis, Aluminium Upstream, Aluminium Downstream, and Copper. The company offers primary aluminum, such as ingots, wirerods, primary foundry alloys, and billets; flat rolled products, including building and pattern sheets, PCB entry and cold-rolled sheets, closure and fin stocks, cable wrap and lamp cap stocks, foil and litho stocks, spiral fin stocks, circles, hot-rolled plates, cold-rolled coils, and flooring sheets/tread plates; extrusions; and foils, as well as aluminium sheet and light gauge products. It also engages in bauxite and coal mining, refineries, and metal and power; and specialty alumina solutions, including refractory, ceramic, polishing, flame retardant, battery, and water treatment solutions. In addition, the company provides copper wire and recycled rods, alloy rods, IGT tubes, and cathodes; precious metals, such as gold and silver bars, selenium, and platinum group metals; and di-ammonium phosphate, as well as internally grooved copper tube and copper scrap recycling operations. Further, it provides mining, investment, cargo, management, import and export aluminum, sales office, captive insurance cell, and welfare services. The company exports its products. It offers its products under the PrizTec, EcoEdge G, EcoEdge C, Everlast, Eternia, Freshwrapp, FUSALOX, and Totalis brands. The company serves the building and construction, batteries and renewable energy, commercial transport, consumer durables, circularity and home solutions, defence and aerospace, electrical and power, industrial machinery, packaging, and personal mobility industries. Hindalco Industries Limited was incorporated in 1958 and is headquartered in Mumbai, India.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-07", "eps_estimate_avg": 28.02762, "eps_estimate_num": 3, "eps_estimate_growth": 0.5571, "eps_estimate_fwd": 105.89649, "revenue_estimate_avg": 846913076920.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NSE", "region": "india"}, "tradingview_symbol": "NSE:HINDALCO", "quote": {"security_id": 1016, "price": 974.5, "prev_close": 970.4, "change": 4.1, "change_pct": 0.422506, "day_open": 944.450012, "day_high": 988.0, "day_low": 971.05, "volume": 5579336, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 60.31, "pe_ttm": 16.16}, "scores": {"id": 545, "security_id": 1016, "as_of": "2026-07-27", "fundamental": 39.09, "technical": 59.15, "momentum": 56.61, "quality": 47.56, "risk": 63.44, "composite": 44.3, "pabrai": 56.2, "breakdown": {"fundamental": {"score": 39.09, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.102892, "sub_score": 41.16, "weight": 0.14, "contribution": 5.7624}, "net_margin": {"label": "Net margin", "value": 0.049116, "sub_score": 24.56, "weight": 0.1, "contribution": 2.456}, "roa": {"label": "Return on assets", "value": 0.043634, "sub_score": 36.36, "weight": 0.08, "contribution": 2.9088}, "gross_margin": {"label": "Gross margin", "value": 0.299715, "sub_score": 49.95, "weight": 0.06, "contribution": 2.997}, "revenue_growth": {"label": "Revenue growth", "value": 0.150281, "sub_score": 71.51, "weight": 0.1, "contribution": 7.151}, "eps_growth": {"label": "EPS growth", "value": -0.162942, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.726013, "sub_score": 70.96, "weight": 0.1, "contribution": 7.096}, "current_ratio": {"label": "Current ratio", "va