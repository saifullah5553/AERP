{"security": {"id": 627, "market_id": 2, "symbol": "OKE", "provider_symbol": "OKE", "name": "Oneok Inc /New/", "asset_class": "equity", "sector": "Energy", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001039684", "long_business_summary": "ONEOK, Inc. operates as a midstream service provider of gathering, processing, fractionation, transportation, storage, and marine export services in the United States. It operates in four segments: Natural Gas Gathering and Processing; Natural Gas Liquids; Natural Gas Pipelines; and Refined Products and Crude. The company owns natural gas gathering pipelines and processing plants in the Mid-Continent, Permian Basin, North Texas, Gulf Coast region, and Rocky Mountain regions; and provides midstream services to producers of NGLs. It also owns NGL gathering and distribution pipelines, fractionation, terminal and storage facilities; and transports refined products, including gasoline, diesel fuel, aviation fuel, kerosene, and heating oil. In addition, the company transports and stores natural gas through regulated interstate and intrastate natural gas transmission pipelines, and natural gas storage facilities; it owns and operates a parking garage in downtown Tulsa, Oklahoma; and leases buildings, warehouses, office space, land, and equipment, including pipeline equipment, pipeline capacity, rail cars, and information technology equipment. Further, the company transports, stores, and distributes refined products, purity NGLs, and crude oil, as well as conducts commodity-related activities, including liquids blending and marketing activities. It serves integrated and independent exploration and production companies; other NGL and natural gas gathering and processing companies; crude oil and natural gas production companies; utilities; industrial companies; natural gasoline distributors; propane distributors; municipalities; ethanol producers; petrochemical, refining, and marketing companies; and diluent users, refineries, and exporters. ONEOK, Inc. was founded in 1906 and is headquartered in Tulsa, Oklahoma.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-04", "eps_estimate_avg": 1.45126, "eps_estimate_num": 12, "eps_estimate_growth": 0.083, "eps_estimate_fwd": 6.08574, "revenue_estimate_avg": 8949851680.0, "eps_revisions_up_30d": 2, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:OKE", "quote": {"security_id": 627, "price": 90.81, "prev_close": 89.07, "change": 1.74, "change_pct": 1.95352, "day_open": 93.470001, "day_high": 90.936, "day_low": 88.743, "volume": 5140463, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 5.43, "pe_ttm": 16.72}, "scores": {"id": 157, "security_id": 627, "as_of": "2026-07-27", "fundamental": 49.21, "technical": 67.79, "momentum": 88.22, "quality": 54.62, "risk": 47.95, "composite": 61.38, "pabrai": 53.9, "breakdown": {"fundamental": {"score": 49.21, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.171706, "sub_score": 68.68, "weight": 0.14, "contribution": 9.6152}, "net_margin": {"label": "Net margin", "value": 0.100895, "sub_score": 50.45, "weight": 0.1, "contribution": 5.045}, "roa": {"label": "Return on assets", "value": 0.051916, "sub_score": 43.26, "weight": 0.08, "contribution": 3.4608}, "gross_margin": {"label": "Gross margin", "value": 0.259954, "sub_score": 43.33, "weight": 0.06, "contribution": 2.5998}, "revenue_growth": {"label": "Revenue growth", "value": 0.549866, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "eps_growth": {"label": "EPS growth", "value": 0.046243, "sub_score": 36.56, "weight": 0.1, "contribution": 3.656}, "debt_to_equity": {"label": "Debt / equity", "value": 1.459462, "sub_score": 41.62, "weight": 0.1, "contribution": 4.162}, "current_ratio": {"label": "Current ratio", "value": 0.705106, "sub_score": 20.51, "weight": 0.06, "