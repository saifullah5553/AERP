{"security": {"id": 636, "market_id": 2, "symbol": "KEYS", "provider_symbol": "KEYS", "name": "Keysight Technologies, Inc.", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001601046", "long_business_summary": "Keysight Technologies, Inc. provides electronic design and test solutions worldwide. The company operates through Communications Solutions Group and Electronic Industrial Solutions Group segments. It offers electronic design and test software, instrumentation, systems, and related services used in the design, simulation, validation, manufacturing, installation, and optimization of communication systems in wireless, data center ecosystem, enterprise, and aerospace, defense, and government end markets. The company also develops and deploys communications products and services; and operates communications networks. In addition, it provides electronic design, test and simulation software, instrumentation, systems, computer-aided engineering solutions, and related services used in the design, simulation, validation, manufacturing, installation, and optimization of electronic equipment in the automotive and energy, semiconductor solutions, and general electronics industries. Further, the company offers product support; technical and application support for hardware, software, and solutions; and professional services, such as installation, training, engineering, optimization of equipment and solution adoption, utilization, and integration services. Additionally, it provides oscilloscopes; generators, sources and power supplies; software products; analyzers; wireless products; network test and security; modular instruments; meters; network visibility; and other products, as well as KeysightCare support plans, calibration, repair, technology refresh, test as a service, network/security, consulting, financial alternatives, education, software testing, support, managed, device vulnerability analysis, support portal, and used equipment services. Keysight Technologies, Inc. was founded in 1939 and is headquartered in Santa Rosa, California.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-19", "eps_estimate_avg": 2.48236, "eps_estimate_num": 13, "eps_estimate_growth": 0.4432, "eps_estimate_fwd": 11.88329, "revenue_estimate_avg": 1748067200.0, "eps_revisions_up_30d": 13, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:KEYS", "quote": {"security_id": 636, "price": 340.5, "prev_close": 321.89, "change": 18.61, "change_pct": 5.781478, "day_open": 323.630005, "day_high": 340.72, "day_low": 332.13, "volume": 320755, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 4.91, "pe_ttm": 69.35}, "scores": {"id": 166, "security_id": 636, "as_of": "2026-07-27", "fundamental": 77.51, "technical": 50.55, "momentum": 53.21, "quality": 61.46, "risk": 62.28, "composite": 71.73, "pabrai": 60.6, "breakdown": {"fundamental": {"score": 77.51, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.154742, "sub_score": 61.9, "weight": 0.14, "contribution": 8.666}, "net_margin": {"label": "Net margin", "value": 0.15814, "sub_score": 79.07, "weight": 0.1, "contribution": 7.907}, "roa": {"label": "Return on assets", "value": 0.082645, "sub_score": 68.87, "weight": 0.08, "contribution": 5.5096}, "gross_margin": {"label": "Gross margin", "value": 0.620837, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.079534, "sub_score": 51.3, "weight": 0.1, "contribution": 5.13}, "eps_growth": {"label": "EPS growth", "value": 0.390935, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.472369, "sub_score": 81.11, "weight": 0.1, "contribution": 8.111}, "current_ratio": {"label": "Current ratio", "v