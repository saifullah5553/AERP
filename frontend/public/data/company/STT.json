{"security": {"id": 648, "market_id": 2, "symbol": "STT", "provider_symbol": "STT", "name": "State Street Corp", "asset_class": "equity", "sector": "Financials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000093751", "long_business_summary": "State Street Corporation provides various financial products and services to institutional investors. It offers custody, accounting, and fund administration services for traditional and alternative assets, as well as multi-asset class investments; recordkeeping, client reporting, and investment book of record, transaction management, loans, cash, derivatives, and collateral services; investor services operations outsourcing; performance, risk, and compliance analytics; financial data management to support institutional investors; foreign exchange, brokerage, and other trading services; securities finance, such as prime services products; and deposit and short-term investment facilities. \nThe company also provides the State Street Alpha platform that combines portfolio management, trading and execution, analytics and compliance tools, and advanced data aggregation and integration with other industry platforms and providers; front-office technology that automates and simplifies the institutional investment process comprising portfolio management and risk analytics, trading, and post-trade settlement with integrated compliance and managed data; investment management solutions; and portfolio management, trading compliance, and manager/sponsor communication. In addition, it offers investment management solutions, such as strategies across equity, fixed income, cash, multi-asset, and alternatives; and ETFs, custom indexed, managed funds, and mandates. The company provides its products and services to mutual funds, collective investment funds and other investment pools, corporate and public retirement plans, insurance companies, wealth managers, investment managers, foundations, and endowments. The company was founded in 1792 and is headquartered in Boston, Massachusetts.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-16", "eps_estimate_avg": 3.61665, "eps_estimate_num": 11, "eps_estimate_growth": 0.301, "eps_estimate_fwd": 15.24932, "revenue_estimate_avg": 3999429000.0, "eps_revisions_up_30d": 4, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:STT", "quote": {"security_id": 648, "price": 184.16, "prev_close": 182.82, "change": 1.34, "change_pct": 0.732961, "day_open": 184.520004, "day_high": 185.21, "day_low": 183.1, "volume": 1426238, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 9.55, "pe_ttm": 19.28}, "scores": {"id": 178, "security_id": 648, "as_of": "2026-07-27", "fundamental": 59.0, "technical": 88.44, "momentum": 97.41, "quality": 68.21, "risk": 75.44, "composite": 76.64, "pabrai": 55.1, "breakdown": {"fundamental": {"score": 59.0, "coverage": 0.75, "weight_present": 0.75, "metrics": {"roe": {"label": "Return on equity", "value": 0.110783, "sub_score": 44.31, "weight": 0.14, "contribution": 6.2034}, "net_margin": {"label": "Net margin", "value": 0.210884, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.008189, "sub_score": 6.82, "weight": 0.08, "contribution": 0.5456}, "revenue_growth": {"label": "Revenue growth", "value": 0.080966, "sub_score": 51.7, "weight": 0.1, "contribution": 5.17}, "eps_growth": {"label": "EPS growth", "value": 0.146459, "sub_score": 61.61, "weight": 0.1, "contribution": 6.161}, "debt_to_equity": {"label": "Debt / equity", "value": 1.040336, "sub_score": 58.39, "weight": 0.1, "contribution": 5.839}, "fcf_margin": {"label": "Free-cash-flow margin", "value": 0.776441, "sub_score": 100.0, "weight": 0.05, "contribution": 5.0}, "piotroski_f": {"label": "Piotroski F-Score", "value": 6.0, "sub_score": 66.67, "weight": 0.08, "contribution": 5.3336}}, "miss