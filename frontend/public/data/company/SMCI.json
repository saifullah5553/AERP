{"security": {"id": 781, "market_id": 1, "symbol": "SMCI", "provider_symbol": "SMCI", "name": "Super Micro Computer, Inc.", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001375365", "long_business_summary": "Super Micro Computer, Inc., together with its subsidiaries, develops and sells server and storage solutions based on modular and open-standard architecture in the United States, Asia, Europe, and internationally. The company provides liquid and air-cooled AI servers for training and inferencing with integrated graphics processing units (GPUs) or PCIe based architectures; SuperBlade, MicroBlade, FlexTwin, GrandTwin, and BigTwin blade and multi-node systems; SuperStorage systems; Hyper, CloudDC, and WIO and rackmount systems; embedded (5G/IoT/Edge) systems; and MicroCloud server systems. It also offers workstations and networking devices; and modular server subsystems and accessories, including server boards, chassis, power supplies, and other accessories. In addition, the company provides remote system management solutions, such as Server Management suite comprising Supermicro Server Manager, Supermicro Power Management software, Supermicro Update Manager, SuperCloud Composer, and SuperDoctor 5. Further, the company identifies service requirements; creates and executes project plans; conducts verification testing; offers training; and provides technical documentation. Additionally, it offers rack level services from design to deployment for full rack and cluster level deployments of AI and HPC datacenters; help desk services and on-site product support; and warranties, maintenance, and technical support services. The company serves enterprise data centers, cloud computing, artificial intelligence, 5G, and edge computing markets through direct and indirect sales force, distributors, value-added resellers, system integrators, and original equipment manufacturers. Super Micro Computer, Inc. was incorporated in 1993 and is headquartered in San Jose, California.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-12", "eps_estimate_avg": 0.95748, "eps_estimate_num": 17, "eps_estimate_growth": 1.3353, "eps_estimate_fwd": 3.31159, "revenue_estimate_avg": 11562988100.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:SMCI", "quote": {"security_id": 781, "price": 28.4, "prev_close": 27.73, "change": 0.67, "change_pct": 2.416156, "day_open": 30.58, "day_high": 29.3, "day_low": 27.21, "volume": 34956061, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 1.77, "pe_ttm": 16.05}, "scores": {"id": 311, "security_id": 781, "as_of": "2026-07-27", "fundamental": 57.63, "technical": 50.53, "momentum": 51.62, "quality": 88.85, "risk": 49.38, "composite": 56.65, "pabrai": 59.9, "breakdown": {"fundamental": {"score": 57.63, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.179002, "sub_score": 71.6, "weight": 0.14, "contribution": 10.024}, "net_margin": {"label": "Net margin", "value": 0.047736, "sub_score": 23.87, "weight": 0.1, "contribution": 2.387}, "roa": {"label": "Return on assets", "value": 0.087974, "sub_score": 73.31, "weight": 0.08, "contribution": 5.8648}, "gross_margin": {"label": "Gross margin", "value": 0.110592, "sub_score": 18.43, "weight": 0.06, "contribution": 1.1058}, "revenue_growth": {"label": "Revenue growth", "value": 0.465853, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "eps_growth": {"label": "EPS growth", "value": -0.185458, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.758343, "sub_score": 69.67, "weight": 0.1, "contribution": 6.967}, "current_ratio": {"label": "Current ratio", "value": 5.246373, "sub_score": 25.12, "weight": 0.06, "contribution": 1.5072}, "