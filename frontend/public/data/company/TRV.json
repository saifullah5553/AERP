t services through independent agencies and brokers. The Personal Insurance segment offers property and casualty insurance covering personal risks, primarily automobile and homeowners' insurance to individuals. The Travelers Companies, Inc. was founded in 1853 and is based in New York, New York."}, "tradingview_symbol": "NYSE:TRV", "quote": {"security_id": 609, "price": 387.26, "prev_close": 377.0, "change": 10.26, "change_pct": 2.721485, "day_open": 378.529999, "day_high": 389.109985, "day_low": 377.86499, "volume": 2110605, "quoted_at": "2026-07-26T14:47:41.084173"}, "scores": {"id": 609, "security_id": 609, "as_of": "2026-07-26", "fundamental": 73.07, "technical": 92.15, "momentum": 90.04, "quality": 73.49, "risk": 76.31, "composite": 81.81, "pabrai": 83.4, "breakdown": {"fundamental": {"score": 73.07, "coverage": 0.81, "weight_present": 0.81, "metrics": {"roe": {"label": "Return on equity", "value": 0.206985, "sub_score": 82.79, "weight": 0.14, "contribution": 11.5906}, "net_margin": {"label": "Net margin", "value": 0.128779, "sub_score": 64.39, "weight": 0.1, "contribution": 6.439}, "roa": {"label": "Return on assets", "value": 0.045418, "sub_score": 37.85, "weight": 0.08, "contribution": 3.028}, "revenue_growth": {"label": "Revenue growth", "value": 0.051693, "sub_score": 43.34, "weight": 0.1, "contribution": 4.334}, "eps_growth": {"label": "EPS growth", "value": 0.278952, "sub_score": 94.74, "weight": 0.1, "contribution": 9.474}, "debt_to_equity": {"label": "Debt / equity", "value": 0.281723, "sub_score": 88.73, "weight": 0.1, "contribution": 8.873}, "interest_coverage": {"label": "Interest coverage", "value": 19.343529, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "fcf_margin": {"label": "Free-cash-flow margin", "value": 0.217211, "sub_score": 100.0, "weight": 0.05, "contribution": 5.0}, "piotroski_f": {"label": "Piotroski F-Score", "value": 5.0, "sub_score": 55.56, "weight": 0.08, "contribution": 4.4448}}, "missing": ["gross_margin", "current_r