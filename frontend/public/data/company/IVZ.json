{"security": {"id": 796, "market_id": 2, "symbol": "IVZ", "provider_symbol": "IVZ", "name": "Invesco Ltd.", "asset_class": "equity", "sector": "Financials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000914208", "long_business_summary": "Invesco Ltd. is a publicly owned investment manager. The firm provides its services to retail clients, institutional clients, high-net worth clients, public entities, corporations, unions, non-profit organizations, endowments, foundations, pension funds, financial institutions, and sovereign wealth funds. It manages separate client-focused equity and fixed income portfolios. The firm also launches equity, commodity, fixed income, multi-asset, and balanced mutual funds for its clients. It launches equity, fixed income, multi-asset, and balanced exchange-traded funds. The firm also launches and manages private funds. It invests in the public equity and fixed income markets across the globe. The firm prefers to invest between $5 million and $15 million in companies. The firm also invests in alternative markets, such as commodities and currencies. For the equity portion of its portfolio, it invests in growth and value stocks of large-cap, mid-cap, and small-cap companies. For the fixed income portion of its portfolio, the firm invests in convertibles, government bonds, municipal bonds, treasury securities, and cash. It also invests in short term and intermediate term bonds, investment grade and high yield bonds, taxable and tax-free bonds, senior secured loans, and structured securities such as asset-backed securities, mortgage-backed securities, and commercial mortgage-backed securities. The firm employs absolute return, global macro, and long/short strategies. It employs quantitative analysis to make its investments. The firm was formerly known as Invesco Plc, AMVESCAP plc, Amvesco plc, Invesco PLC, Invesco MIM, and H. Lotery & Co. Ltd. Invesco Ltd. was founded in 1935 and is based in Atlanta, Georgia with an additional office in Asia, Europe, Africa and North America.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-28", "eps_estimate_avg": 0.66151, "eps_estimate_num": 11, "eps_estimate_growth": 0.8375, "eps_estimate_fwd": 3.20952, "revenue_estimate_avg": 1334564100.0, "eps_revisions_up_30d": 4, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:IVZ", "quote": {"security_id": 796, "price": 30.11, "prev_close": 29.93, "change": 0.18, "change_pct": 0.601403, "day_open": 30.059999, "day_high": 30.63, "day_low": 29.65, "volume": 7345847, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 326, "security_id": 796, "as_of": "2026-07-27", "fundamental": 24.98, "technical": 91.01, "momentum": 97.64, "quality": 25.48, "risk": 51.91, "composite": 58.8, "pabrai": 33.8, "breakdown": {"fundamental": {"score": 24.98, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": -0.02103, "sub_score": 0.0, "weight": 0.14, "contribution": 0.0}, "net_margin": {"label": "Net margin", "value": -0.044174, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "roa": {"label": "Return on assets", "value": -0.010413, "sub_score": 0.0, "weight": 0.08, "contribution": 0.0}, "gross_margin": {"label": "Gross margin", "value": 0.352386, "sub_score": 58.73, "weight": 0.06, "contribution": 3.5238}, "revenue_growth": {"label": "Revenue growth", "value": 0.051113, "sub_score": 43.18, "weight": 0.1, "contribution": 4.318}, "eps_growth": {"label": "EPS growth", "value": -2.355932, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.799975, "sub_score": 68.0, "weight": 0.1, "contribution": 6.8}, "current_ratio": {"label": "Current ratio", "value": 12.002007, "sub_score": 0.0, "weight": 0.06, "contribution": 0.0}, "interest_coverage": {"label": "Interest coverage", "value": -3.598788,