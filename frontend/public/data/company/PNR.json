{"security": {"id": 815, "market_id": 2, "symbol": "PNR", "provider_symbol": "PNR", "name": "Pentair Plc", "asset_class": "equity", "sector": "Industrials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000077360", "long_business_summary": "Pentair plc provides various water solutions in the United States, Western Europe, China, Latin America, the Middle East, Southeast Asia, Australia, and Canada. It operates through three segments: Flow, Water Solutions, and Pool. The Flow segment designs, manufactures, and sells fluid treatment and pump products and systems, including pressure vessels, gas recovery solutions, membrane bioreactors, wastewater reuse systems and advanced membrane filtration, separation systems, specialty insertion valves, water disposal pumps, water supply pumps, fluid transfer pumps, turbine pumps, solid handling pumps, and agricultural spray nozzles. This segment provides products under Pentair Flow, Aurora, Berkeley, Codeline, Fairbanks-Nijhuis, Haffmans, Hydromatic, Hypro, Jung Pumpen, Myers, Sta-Rite, Shurflo, S\u00fcdmo, and X-Flow brand names. The Water Solutions segment offers commercial and residential water treatment products and systems, such as pressure tanks, control valves, activated carbon products, commercial ice machines, conventional filtration products, and point-of-entry and point-of-use water treatment systems for use in water filtration and water softening solutions, as well as commercial water management and filtration solutions in foodservice operations; and installation and preventative services for water management solutions for commercial operators under the Pentair Water Solutions, Everpure, Fleck, Manitowoc Ice, Pentek, and RainSoft brands. The Pool segment provides residential and commercial pool equipment and accessories, including pumps, filters, heaters, lights, automatic controls and cleaners, chlorinators, maintenance equipment, and pool accessories for residential and commercial pool maintenance, pool repair, renovation, service, construction, and aquaculture solutions. This segment offers products under the Pentair Pool, Kreepy Krauly, Pleatco, and Sta-Rite brands. Pentair plc was founded in 1966 and is headquartered in London, the United Kingdom.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-28", "eps_estimate_avg": 1.12212, "eps_estimate_num": 14, "eps_estimate_growth": -0.1927, "eps_estimate_fwd": 5.29113, "revenue_estimate_avg": 956303120.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 2, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:PNR", "quote": {"security_id": 815, "price": 65.26, "prev_close": 66.17, "change": -0.91, "change_pct": -1.375246, "day_open": 61.830002, "day_high": 66.445, "day_low": 64.935, "volume": 1508472, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 345, "security_id": 815, "as_of": "2026-07-27", "fundamental": 70.9, "technical": 22.15, "momentum": 2.68, "quality": 77.81, "risk": 55.55, "composite": 46.86, "pabrai": 74.4, "breakdown": {"fundamental": {"score": 70.9, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.17594, "sub_score": 70.38, "weight": 0.14, "contribution": 9.8532}, "net_margin": {"label": "Net margin", "value": 0.156561, "sub_score": 78.28, "weight": 0.1, "contribution": 7.828}, "roa": {"label": "Return on assets", "value": 0.098203, "sub_score": 81.84, "weight": 0.08, "contribution": 6.5472}, "gross_margin": {"label": "Gross margin", "value": 0.404765, "sub_score": 67.46, "weight": 0.06, "contribution": 4.0476}, "revenue_growth": {"label": "Revenue growth", "value": 0.022827, "sub_score": 35.09, "weight": 0.1, "contribution": 3.509}, "eps_growth": {"label": "EPS growth", "value": 0.055556, "sub_score": 38.89, "weight": 0.1, "contribution": 3.889}, "debt_to_equity": {"label": "Debt / equity", "value": 0.456399, "sub_score": 81.74, "weight": 