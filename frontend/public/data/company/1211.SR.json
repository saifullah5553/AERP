{"security": {"id": 1010, "market_id": 7, "symbol": "1211", "provider_symbol": "1211.SR", "name": "Maaden (Saudi Arabian Mining)", "asset_class": "equity", "sector": "Materials", "industry": null, "currency": "SAR", "country": "SA", "isin": null, "figi": null, "cik": null, "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-03", "eps_estimate_avg": null, "eps_estimate_num": null, "eps_estimate_growth": null, "eps_estimate_fwd": 2.81409, "revenue_estimate_avg": 9097851330.0, "eps_revisions_up_30d": null, "eps_revisions_down_30d": null, "is_active": true, "market_code": "TADAWUL", "region": "gcc", "long_business_summary": "Saudi Arabian Mining Company (Maaden) operates as a mining and metals company in the Kingdom of Saudi Arabia, India, Pakistan, Bangladesh, Singapore, Korea, the United States, Europe, Australia, Brazil, Africa, Gulf Cooperation Council countries, and internationally. The company operates through Phosphate Strategic Business Unit, Aluminium Strategic Business Unit, Base Metals and New Minerals Strategic Business Unit, and All other segments. It primarily mines for gold, phosphate rock, bauxite, kaolin, and magnesite, as well as copper, zinc, carbon, and silver concentrates. The company primarily holds interests in the e Mansourah-Massarah, Ar-Rjum, Mahd Ad-Dahab, Bulghah, Al-Amar, Sukhaybarat, As Suq, Ad Duwayhi, Al-Jalamid, Al-Khabra, Az Zabirah, Al-Ghazallah, and Al-Ba'itha mines. It also produces and sells phosphate fertilizers, ammonia, and industrial minerals, as well as alumina, aluminum, and flat rolled products directly to customers and through marketing agents. In addition, the company offers ingots, slabs, and billets; caustic soda and Ethylene Dichloride (EDC); and potassium fertilizers. Further, it is involved in procurement, marketing, project management and execution, exploration, funding and treasury management and other support activities; development and operation of smelters; and providing cooperative insurance, reinsurance, and related activities. Saudi Arabian Mining Company (Maaden) was founded in 1997 and is based in Riyadh, the Kingdom of Saudi Arabia."}, "tradingview_symbol": "TADAWUL:1211", "quote": {"security_id": 1010, "price": 58.200001, "prev_close": 58.099998, "change": 0.100002, "change_pct": 0.172121, "day_open": 58.0, "day_high": 58.849998, "day_low": 57.650002, "volume": 543472, "quoted_at": "2026-07-26T15:16:56.645004"}, "scores": {"id": 1009, "security_id": 1010, "as_of": "2026-07-26", "fundamental": 71.1, "technical": 29.46, "momentum": 37.73, "quality": 73.26, "risk": 63.58, "composite": 52.65, "pabrai": 55.6, "breakdown": {"fundamental": {"score": 71.1, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.129502, "sub_score": 51.8, "weight": 0.14, "contribution": 7.252}, "net_margin": {"label": "Net margin", "value": 0.190469, "sub_score": 95.23, "weight": 0.1, "contribution": 9.523}, "roa": {"label": "Return on assets", "value": 0.062576, "sub_score": 52.15, "weight": 0.08, "contribution": 4.172}, "gross_margin": {"label": "Gross margin", "value": 0.383431, "sub_score": 63.91, "weight": 0.06, "contribution": 3.8346}, "revenue_growth": {"label": "Revenue growth", "value": 0.185324, "sub_score": 81.52, "weight": 0.1, "contribution": 8.152}, "eps_growth": {"label": "EPS growth", "value": 1.448718, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.549483, "sub_score": 78.02, "weight": 0.1, "contribution": 7.802}, "current_ratio": {"label": "Current ratio", "value": 1.538857, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "interest_coverage": {"label": "Interest coverage", "value": 6.675054, "sub_score": 63.06, "weight": 0.06, "contribution": 3.7836}, "fcf_margin": {"label": "Free-cash-flow margin", "value": 0.104184, "sub_score": 69.46, "weight": 0.05, "contribution": 3.473}, "piotroski_f": {"label": "Piotroski F-Score", "value":