{"security": {"id": 745, "market_id": 2, "symbol": "DGX", "provider_symbol": "DGX", "name": "Quest Diagnostics Inc", "asset_class": "equity", "sector": "Health Care", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001022079", "long_business_summary": "Quest Diagnostics Incorporated provides diagnostic testing and services in the United States. The company develops and delivers diagnostic information services, such as routine, non-routine and advanced clinical testing, anatomic pathology testing, and other diagnostic information services. It also provides services under the Quest Diagnostics brand, as well as under the AmeriPath, Dermpath Diagnostics, ExamOne, and Quanum brands to physicians, hospitals, patients and consumers, health plans, government agencies, employers, retailers, pharmaceutical companies and insurers commercial clinical laboratories, and accountable care organizations through a network of laboratories, patient service centers, phlebotomists in physician offices, call centers and mobile phlebotomists, nurses, and other health and wellness professionals. In addition, the company offers risk assessment services for the life insurance industry; healthcare IT healthcare providers and payers; testing and medical director services at hospital laboratories; test offerings in cardiometabolic and endocrine; cancer; clinical drug monitoring and toxicology; infectious disease, including autoimmune; neurology diagnostics, including Alzheimer's disease; and women's health, such as prenatal genetic; workplace drug testing, testing urine, hair, and oral fluid specimens services; and employer population health services, including biometric screenings, flu shots, and related preventative services. Further, it provides population health solutions; extended care services; develops in vitro diagnostic tests; laboratory diagnostic information and digital health connectivity systems; underwriting support services, including data gathering, paramedical examinations, and clinical laboratory testing and analytics; and national specimen collection and health data solutions. Quest Diagnostics Incorporated was founded in 1967 and is headquartered in Secaucus, New Jersey.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-20", "eps_estimate_avg": 2.84798, "eps_estimate_num": 14, "eps_estimate_growth": 0.0954, "eps_estimate_fwd": 11.93706, "revenue_estimate_avg": 3046643250.0, "eps_revisions_up_30d": 4, "eps_revisions_down_30d": 7, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:DGX", "quote": {"security_id": 745, "price": 231.95, "prev_close": 233.01, "change": -1.06, "change_pct": -0.454916, "day_open": 228.0, "day_high": 233.435, "day_low": 230.645, "volume": 839240, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 8.87, "pe_ttm": 26.15}, "scores": {"id": 275, "security_id": 745, "as_of": "2026-07-27", "fundamental": 59.31, "technical": 88.2, "momentum": 96.37, "quality": 62.2, "risk": 60.36, "composite": 68.16, "pabrai": 61.4, "breakdown": {"fundamental": {"score": 59.31, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.142243, "sub_score": 56.9, "weight": 0.14, "contribution": 7.966}, "net_margin": {"label": "Net margin", "value": 0.089896, "sub_score": 44.95, "weight": 0.1, "contribution": 4.495}, "roa": {"label": "Return on assets", "value": 0.061276, "sub_score": 51.06, "weight": 0.08, "contribution": 4.0848}, "gross_margin": {"label": "Gross margin", "value": 0.332125, "sub_score": 55.35, "weight": 0.06, "contribution": 3.321}, "revenue_growth": {"label": "Revenue growth", "value": 0.117808, "sub_score": 62.23, "weight": 0.1, "contribution": 6.223}, "eps_growth": {"label": "EPS growth", "value": 0.140103, "sub_score": 60.03, "weight": 0.1, "contribution": 6.003}, "debt_to_equity": {"label": "Debt / equity", "value": 0.91841, "sub_score": 63.26, "weight": 0.1, "con