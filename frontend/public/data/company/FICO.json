{"security": {"id": 707, "market_id": 2, "symbol": "FICO", "provider_symbol": "FICO", "name": "Fair Isaac Corp", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000814547", "long_business_summary": "Fair Isaac Corporation provides analytics software in the Americas, Europe, the Middle East, Africa, and the Asia Pacific. It operates through two segments, Scores and Software. The Scores segment offers business-to-business scoring solutions and services that give clients access to predictive credit and other scores that can be integrated into their transaction streams and decision-making processes, as well as business-to-consumer scoring solutions comprising myFICO.com subscription offerings. Its Software segment provides pre-configured analytic and decision management solution designed for various business needs or processes, such as account origination, customer management, customer engagement, fraud detection, and marketing, as well as associated professional services. This segment also offers FICO Platform, a modular software offering designed to support advanced analytic and decision use cases, as well as stand-alone analytic and decisioning software that can be configured by customers to address a wide range of business use cases. In addition, the company offers analytic and decisioning software comprising FICO Decision Modeler, FICO Blaze Advisor, FICO Xpress Optimization, FICO Analytics Workbench, FICO Data Orchestrator, FICO DMP Streaming, FICO Business Outcome Simulator, and FICO Decision Optimizer; pre-configured solutions consisting of FICO Fraud Solutions, FICO Originations, FICO Customer Communication Service, FICO Strategy Director, and FICO TRIAD Customer Manager; and professional services software, including FICO Implementation Services and FICO Analytic Services. It markets its products and services primarily through its direct sales organization and indirect channels, as well as online. The company was formerly known as Fair Isaac & Company, Inc. and changed its name to Fair Isaac Corporation in July 1992. Fair Isaac Corporation was founded in 1956 and is headquartered in Bozeman, Montana.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-30", "eps_estimate_avg": 11.77603, "eps_estimate_num": 17, "eps_estimate_growth": 0.3741, "eps_estimate_fwd": 54.55058, "revenue_estimate_avg": 676731190.0, "eps_revisions_up_30d": 2, "eps_revisions_down_30d": 2, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:FICO", "quote": {"security_id": 707, "price": 1139.54, "prev_close": 1373.08, "change": -233.54, "change_pct": -17.008477, "day_open": 1220.0, "day_high": 1238.6, "day_low": 1125.39, "volume": 956739, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 237, "security_id": 707, "as_of": "2026-07-27", "fundamental": 75.48, "technical": 55.97, "momentum": 73.61, "quality": 64.45, "risk": 86.22, "composite": 69.14, "pabrai": 74.0, "breakdown": {"fundamental": {"score": 75.48, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": -0.481414, "sub_score": 0.0, "weight": 0.14, "contribution": 0.0}, "net_margin": {"label": "Net margin", "value": 0.327468, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.363605, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.822328, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.159149, "sub_score": 74.04, "weight": 0.1, "contribution": 7.404}, "eps_growth": {"label": "EPS growth", "value": 0.294514, "sub_score": 98.63, "weight": 0.1, "contribution": 9.863}, "debt_to_equity": {"label": "Debt / equity", "value": -1.761316, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "current_r