{"security": {"id": 541, "market_id": 2, "symbol": "SPGI", "provider_symbol": "SPGI", "name": "S&P Global Inc.", "asset_class": "equity", "sector": "Financials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000064040", "long_business_summary": "S&P Global Inc., together with its subsidiaries, provides benchmarks, data, analytics, and workflow solutions in the global capital, energy and commodity, and automotive markets. It operates through four segments: S&P Global Market Intelligence, S&P Global Ratings, S&P Global Energy, and S&P Dow Jones Indices. The S&P Global Market Intelligence segment provides multi-asset-class data and analytics integrated with purpose-built workflow solutions. This segment offers Data, Analytics & Insights, a desktop product suite that provides data, analytics, and third-party research for global finance and corporate professionals; research, reference data, market data, derived analytics, and valuation services; enterprise solutions, such as software and workflow solutions; and credit and risk solutions for selling Ratings' credit ratings and related data and research, analytics, and financial risk solutions. The S&P Global Ratings segment operates as an independent provider of credit ratings, research, and analytics offering investors information and independent benchmarks for their investment and financial decisions as well as access to the capital markets. The S&P Global Energy segment provides information and benchmark prices for the energy and commodity markets. The S&P Dow Jones Indices segment operates as an index provider that maintains various valuation and index benchmarks for investment advisors, wealth managers, and institutional investors. It has operations in the United States, European region, Asia, and internationally. S&P Global Inc. was founded in 1860 and is headquartered in New York, New York.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-28", "eps_estimate_avg": 5.00271, "eps_estimate_num": 12, "eps_estimate_growth": 0.1293, "eps_estimate_fwd": 20.29993, "revenue_estimate_avg": 4117735890.0, "eps_revisions_up_30d": 4, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:SPGI", "quote": {"security_id": 541, "price": 416.15, "prev_close": 416.25, "change": -0.1, "change_pct": -0.024024, "day_open": 424.51001, "day_high": 418.78, "day_low": 411.89, "volume": 716288, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 14.67, "pe_ttm": 28.37}, "scores": {"id": 71, "security_id": 541, "as_of": "2026-07-27", "fundamental": 68.78, "technical": 34.47, "momentum": 57.11, "quality": 89.4, "risk": 52.6, "composite": 63.16, "pabrai": 68.4, "breakdown": {"fundamental": {"score": 68.78, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.139097, "sub_score": 55.64, "weight": 0.14, "contribution": 7.7896}, "net_margin": {"label": "Net margin", "value": 0.291536, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.073645, "sub_score": 61.37, "weight": 0.08, "contribution": 4.9096}, "gross_margin": {"label": "Gross margin", "value": 0.702465, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.079392, "sub_score": 51.25, "weight": 0.1, "contribution": 5.125}, "eps_growth": {"label": "EPS growth", "value": 0.186893, "sub_score": 71.72, "weight": 0.1, "contribution": 7.172}, "debt_to_equity": {"label": "Debt / equity", "value": 0.436341, "sub_score": 82.55, "weight": 0.1, "contribution": 8.255}, "current_ratio": {"label": "Current ratio", "value": 0.824407, "sub_score": 32.44, "weight": 0.06, "contribution": 1.9464}, "interest_coverage": {"label": "Interest coverage", "value": 22.696864, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "fcf_margin": {"label": "Free-cash-flow margin", 