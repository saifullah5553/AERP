{"security": {"id": 921, "market_id": 2, "symbol": "EL", "provider_symbol": "EL", "name": "Estee Lauder Companies Inc", "asset_class": "equity", "sector": "Consumer Staples", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001001250", "long_business_summary": "The Est\u00e9e Lauder Companies Inc. manufactures, markets, and sells skin care, makeup, fragrance, and hair care products worldwide. The company offers skin care products, including moisturizers, serums, cleansers, toners, eye care, body care, exfoliators, acne care and oil correctors, facial masks, and sun care products; and makeup products, such as foundations, powders, concealers and setting sprays, lipsticks, lip liners and lip glosses, mascaras, and eyeshadows and eyeliners, as well as compacts, brushes, and other makeup tools. It also provides fragrance products in various forms comprising parfum, eau de parfum, eau de toilette, eau de cologne, and body spray, as well as lotions, creams, powders, candles and soaps; and hair care products, including shampoos, conditioners, styling products, treatment, finishing sprays, and hair colour products, as well as sells ancillary products and services. The company offers its products under the La Mer, Jo Malone London, TOM FORD, AERIN Beauty, Le Labo, Editions de Parfums Fr\u00e9d\u00e9ric Malle, KILIAN PARIS, BALMAIN Beauty, Est\u00e9e Lauder, Clinique, M\u00b7A\u00b7C, The Ordinary, Aveda, Bobbi Brown Cosmetics, Too Faced, Dr.Jart+, Bumble and bumble, Smashbox, Darphin Paris, Lab Series, NIOD, Aramis, and GLAMGLOW brands. It sells its products through department stores, duty-free retailers, specialty multi retailers, online pure players, upscale perfumeries and pharmacies, and top-tier salons and spas, as well as direct-to-consumer businesses across freestanding stores, and brand websites and third-party online platforms. The Est\u00e9e Lauder Companies Inc. was founded in 1946 and is headquartered in New York, New York.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-19", "eps_estimate_avg": 0.3152, "eps_estimate_num": 22, "eps_estimate_growth": 2.5022, "eps_estimate_fwd": 3.17912, "revenue_estimate_avg": 3546518600.0, "eps_revisions_up_30d": 1, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:EL", "quote": {"security_id": 921, "price": 84.49, "prev_close": 84.88, "change": -0.39, "change_pct": -0.459472, "day_open": 80.209999, "day_high": 84.76, "day_low": 83.14, "volume": 579113, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 451, "security_id": 921, "as_of": "2026-07-27", "fundamental": 16.63, "technical": 56.87, "momentum": 53.57, "quality": 26.11, "risk": 32.07, "composite": 38.79, "pabrai": 29.8, "breakdown": {"fundamental": {"score": 16.63, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": -0.246868, "sub_score": 0.0, "weight": 0.14, "contribution": 0.0}, "net_margin": {"label": "Net margin", "value": -0.079087, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "roa": {"label": "Return on assets", "value": -0.054512, "sub_score": 0.0, "weight": 0.08, "contribution": 0.0}, "gross_margin": {"label": "Gross margin", "value": 0.739704, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": -0.082137, "sub_score": 5.1, "weight": 0.1, "contribution": 0.51}, "eps_growth": {"label": "EPS growth", "value": -3.889908, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 2.449418, "sub_score": 2.02, "weight": 0.1, "contribution": 0.202}, "current_ratio": {"label": "Current ratio", "value": 1.300644, "sub_score": 80.06, "weight": 0.06, "contribution": 4.8036}, "interest_coverage": {"label": "Interest coverage", "value": -1.913165, "sub_score": 0.0, "weight": 0.06, "contribution": 0.0}, "fcf_margin": {"lab