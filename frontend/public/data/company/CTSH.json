{"security": {"id": 757, "market_id": 1, "symbol": "CTSH", "provider_symbol": "CTSH", "name": "Cognizant Technology Solutions Corp", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001058290", "long_business_summary": "Cognizant Technology Solutions Corporation, a professional services company, provides consulting and technology, and outsourcing services in North America, Europe, and internationally. It operates through four segments: Financial Services; Health Sciences; Products and Resources; and Communications, Media and Technology. The company provides services including artificial intelligence (AI) and other technology services and solutions, consulting, application development, systems integration, quality engineering and assurance, engineering research and development, application maintenance, infrastructure, security, and business process services and automation. It also offers AI-led automation, which includes advisory, and process and IT automation solutions designed to simplify and accelerate automation adoption; business process outsourcing services, which help deliver business outcomes including revenue growth, increased customer and employee satisfaction, and cost savings; and Cognizant Moment, a digital experience service that uses AI to reimagine customer experiences and engineer strategies aimed at driving growth. In addition, the company develops, licenses, implements, and supports proprietary and third-party software products and platforms; and develops industry-specific products and services. It offers solution to healthcare providers and payers, life sciences companies, banking, capital markets, payments and insurance companies, manufacturers, automakers, retailers, consumer goods, travel and hospitality, communications, media and entertainment, education, information services, and technology companies, as well as businesses providing logistics, energy, and utility services. The company has a strategic partnership with Uniphore Technologies Inc. for the development of AI solutions that combine small language models and AI agents. Cognizant Technology Solutions Corporation was incorporated in 1988 and is headquartered in Teaneck, New Jersey.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-29", "eps_estimate_avg": 1.3787, "eps_estimate_num": 24, "eps_estimate_growth": 0.0524, "eps_estimate_fwd": 6.18523, "revenue_estimate_avg": 5483277180.0, "eps_revisions_up_30d": 2, "eps_revisions_down_30d": 4, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:CTSH", "quote": {"security_id": 757, "price": 53.885, "prev_close": 55.17, "change": -1.285, "change_pct": -2.329164, "day_open": 43.41, "day_high": 54.575, "day_low": 53.59, "volume": 406730, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 4.57, "pe_ttm": 11.79}, "scores": {"id": 287, "security_id": 757, "as_of": "2026-07-27", "fundamental": 71.09, "technical": 70.79, "momentum": 62.61, "quality": 72.8, "risk": 78.42, "composite": 70.89, "pabrai": 74.8, "breakdown": {"fundamental": {"score": 71.09, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.151582, "sub_score": 60.63, "weight": 0.14, "contribution": 8.4882}, "net_margin": {"label": "Net margin", "value": 0.105647, "sub_score": 52.82, "weight": 0.1, "contribution": 5.282}, "roa": {"label": "Return on assets", "value": 0.109696, "sub_score": 91.41, "weight": 0.08, "contribution": 7.3128}, "gross_margin": {"label": "Gross margin", "value": 0.337171, "sub_score": 56.2, "weight": 0.06, "contribution": 3.372}, "revenue_growth": {"label": "Revenue growth", "value": 0.069518, "sub_score": 48.43, "weight": 0.1, "contribution": 4.843}, "eps_growth": {"label": "EPS growth", "value": 0.011062, "sub_score": 27.77, "weight": 0.1, "contribution": 2.777}, "debt_to_equity": {"label": "Debt / equi