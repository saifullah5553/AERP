{"security": {"id": 878, "market_id": 2, "symbol": "CHD", "provider_symbol": "CHD", "name": "Church & Dwight Co Inc /De/", "asset_class": "equity", "sector": "Consumer Staples", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000313927", "long_business_summary": "Church & Dwight Co., Inc. develops, manufactures, and markets household, personal care, and specialty products. It operates in three segments: Consumer Domestic, Consumer International, and Specialty Products Division. The company offers baking soda, cat litters, laundry detergents, carpet deodorizers, and other baking soda-based products under the ARM & HAMMER brand; stain removers, cleaning solutions, laundry detergents, and bleach alternatives under the OXICLEAN brand; dry shampoos under the BATISTE brand; water flossers under the WATERPIK brand; oral care products under the THERABREATH brand; acne treatment products under the HERO brand; hand sanitizers under the TOUCHLAND brand; and condoms, lubricants, and vibrators under the TROJAN brand. It also provides home pregnancy and ovulation test kits under the FIRST RESPONSE brand; depilatories under the NAIR; oral analgesics under the ORAJEL brand; laundry detergents under the XTRA brand; and cold shortening and relief products under the ZICAM brand. In addition, the company's specialty products include animal and food productivity products, such as ARM & HAMMER baking soda as a feed additive to help dairy cow; BIO-CHLOR and FERMENTEN used to reduce health issues associated with calving, as well as needed protein; CELMANAX refined functional carbohydrate, a yeast-based prebiotic; and CERTILLUS a probiotics products used in the poultry, dairy, beef, and swine industries. Additionally, it offers sodium bicarbonate; and cleaning and deodorizing products. The company sells its consumer products through supermarkets, mass merchandisers, wholesale clubs, drugstores, convenience stores, home stores, dollar and other discount stores, pet and other specialty stores, websites and other e-commerce channels; and specialty products to industrial customers and livestock producers through distributors. Church & Dwight Co., Inc. was founded in 1846 and is headquartered in Ewing, New Jersey.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-31", "eps_estimate_avg": 0.89858, "eps_estimate_num": 10, "eps_estimate_growth": -0.0441, "eps_estimate_fwd": 4.04599, "revenue_estimate_avg": 1511334690.0, "eps_revisions_up_30d": 1, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:CHD", "quote": {"security_id": 878, "price": 99.07, "prev_close": 97.68, "change": 1.39, "change_pct": 1.423014, "day_open": 96.449997, "day_high": 99.79, "day_low": 94.88, "volume": 1363212, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 408, "security_id": 878, "as_of": "2026-07-27", "fundamental": 71.79, "technical": 76.65, "momentum": 74.33, "quality": 75.13, "risk": 80.33, "composite": 75.62, "pabrai": 71.8, "breakdown": {"fundamental": {"score": 71.79, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.176205, "sub_score": 70.48, "weight": 0.14, "contribution": 9.8672}, "net_margin": {"label": "Net margin", "value": 0.118777, "sub_score": 59.39, "weight": 0.1, "contribution": 5.939}, "roa": {"label": "Return on assets", "value": 0.082807, "sub_score": 69.01, "weight": 0.08, "contribution": 5.5208}, "gross_margin": {"label": "Gross margin", "value": 0.447318, "sub_score": 74.55, "weight": 0.06, "contribution": 4.473}, "revenue_growth": {"label": "Revenue growth", "value": 0.015736, "sub_score": 33.07, "weight": 0.1, "contribution": 3.307}, "eps_growth": {"label": "EPS growth", "value": 0.271967, "sub_score": 92.99, "weight": 0.1, "contribution": 9.299}, "debt_to_equity": {"label": "Debt / equity", "value": 0.550972, "sub_score": 77.96, "weight": 0.1, "contribution