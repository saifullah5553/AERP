{"security": {"id": 608, "market_id": 2, "symbol": "MSI", "provider_symbol": "MSI", "name": "Motorola Solutions, Inc.", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000068505", "long_business_summary": "Motorola Solutions, Inc. provides public safety, government, defense, and enterprise security solutions in the United States, the United Kingdom, Canada, and internationally. It operates in two segments, Products and Systems Integration, and Software and Services. The Products and Systems Integration segment offers a portfolio of infrastructure, devices, accessories, and the implementation and integration of systems, devices, software, and applications for government, including defense, public safety, and enterprise customers who operate private communications systems and video security solutions, as well as manage a mobile workforce. This segment also provides mission critical networks, and video security and access control technologies, including two-way portable and vehicle-mounted radios, video cameras, and accessories; communications network core and central processing software, base stations, consoles, and repeaters; and video analytics, network video management hardware and software, and access control solutions. The Software and Services segment offers public safety and enterprise command center, unified communications applications, mobile video equipment, and video software solutions; repair, technical support, and maintenance services; and monitoring, software updates, and cybersecurity services to government, public safety, and commercial communications networks. It serves hospitality; manufacturing; military and defence; police; air transportation; fire and rescue; stadium; emergency medical services; mining; oil and gas; transportation and logistics; utilities; education; retail; and healthcare industries. The company was formerly known as Motorola, Inc. and changed its name to Motorola Solutions, Inc. in January 2011. Motorola Solutions, Inc. was founded in 1928 and is headquartered in Chicago, Illinois.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-06", "eps_estimate_avg": 3.85324, "eps_estimate_num": 13, "eps_estimate_growth": 0.0793, "eps_estimate_fwd": 18.53727, "revenue_estimate_avg": 3001851700.0, "eps_revisions_up_30d": 5, "eps_revisions_down_30d": 5, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:MSI", "quote": {"security_id": 608, "price": 437.19, "prev_close": 435.75, "change": 1.44, "change_pct": 0.330465, "day_open": 406.709991, "day_high": 442.21, "day_low": 435.94, "volume": 673709, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 12.93, "pe_ttm": 33.81}, "scores": {"id": 138, "security_id": 608, "as_of": "2026-07-27", "fundamental": 70.29, "technical": 68.32, "momentum": 69.49, "quality": 84.94, "risk": 38.52, "composite": 71.8, "pabrai": 75.1, "breakdown": {"fundamental": {"score": 70.29, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 1.047411, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.184386, "sub_score": 92.19, "weight": 0.1, "contribution": 9.219}, "roa": {"label": "Return on assets", "value": 0.126766, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.516607, "sub_score": 86.1, "weight": 0.06, "contribution": 5.166}, "revenue_growth": {"label": "Revenue growth", "value": 0.079967, "sub_score": 51.42, "weight": 0.1, "contribution": 5.142}, "eps_growth": {"label": "EPS growth", "value": 0.368254, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "debt_to_equity": {"label": "Debt / equity", "value": 4.052282, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "current_ratio": {"label": "Current ratio", "value": 1.036525, "sub_s