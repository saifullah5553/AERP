{"security": {"id": 970, "market_id": 2, "symbol": "IR", "provider_symbol": "IR", "name": "Ingersoll Rand Inc.", "asset_class": "equity", "sector": "Industrials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001699150", "long_business_summary": "Ingersoll Rand Inc. provides mission-critical air, fluid, clean energy, and medical technologies services and solutions worldwide. It operates in two segments, Industrial Technologies and Services, and Precision and Science Technologies. The Industrial Technologies and Services segment designs, manufactures, markets, and services a range of air and gas compression and treatment equipment, vacuum and blower products, fluid transfer equipment, loading systems, and power tools and lifting equipment; and other specialized equipment, including aftermarket parts, consumables and services, air treatment equipment, controls, other accessories, and services under the Ingersoll Rand, Gardner Denver, Nash, CompAir, Elmo Rietschle, and other brands. The Precision and Science Technologies segment designs, manufactures, and markets diaphragm, piston, water-powered, peristaltic, gear, vane, progressive cavity, and syringe pumps; and gas boosters, hydrogen compression systems, liquid handling systems, odorant injection systems, controls, software, and other related components and accessories for precision dosing, liquid and solid transfer, dispensing, gas compression and sampling, pressure management, flow control, powder handling, and other applications under the Air Dimensions, Albin, ARO, Dosatron, Haskel, Ingersoll Rand, LMI, Maximus, Milton Roy, MP, Oberdorfer, Seepex, Thomas, Welch, Williams, YZ, and Zinnser Analytic brands. This segment's products are used in medical, laboratory, industrial manufacturing, water and wastewater, chemical processing, clean energy, food and beverage, agriculture and other markets. It sells its products through a network of direct sales representatives and independent distributors. It has a strategic alliance with Garrett Motion. The company was formerly known as Gardner Denver Holdings, Inc. and changed its name to Ingersoll Rand Inc. in March 2020. Ingersoll Rand Inc. was founded in 1859 and is headquartered in Davidson, North Carolina.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-31", "eps_estimate_avg": 0.82646, "eps_estimate_num": 13, "eps_estimate_growth": 0.0331, "eps_estimate_fwd": 3.85114, "revenue_estimate_avg": 1956395750.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 2, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:IR", "quote": {"security_id": 970, "price": 87.78, "prev_close": 83.38, "change": 4.4, "change_pct": 5.277045, "day_open": 84.07, "day_high": 87.85, "day_low": 84.9, "volume": 5723930, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": null, "pe_ttm": null}, "scores": {"id": 500, "security_id": 970, "as_of": "2026-07-27", "fundamental": 78.71, "technical": 76.95, "momentum": 73.66, "quality": 33.33, "risk": 80.96, "composite": 79.11, "pabrai": 51.6, "breakdown": {"fundamental": {"score": 44.88, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.057369, "sub_score": 22.95, "weight": 0.14, "contribution": 3.213}, "net_margin": {"label": "Net margin", "value": 0.075991, "sub_score": 38.0, "weight": 0.1, "contribution": 3.8}, "roa": {"label": "Return on assets", "value": 0.032027, "sub_score": 26.69, "weight": 0.08, "contribution": 2.1352}, "gross_margin": {"label": "Gross margin", "value": 0.436066, "sub_score": 72.68, "weight": 0.06, "contribution": 4.3608}, "revenue_growth": {"label": "Revenue growth", "value": 0.057484, "sub_score": 45.0, "weight": 0.1, "contribution": 4.5}, "eps_growth": {"label": "EPS growth", "value": -0.298077, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.480634, "sub_score": 8