{"security": {"id": 692, "market_id": 2, "symbol": "RJF", "provider_symbol": "RJF", "name": "Raymond James Financial Inc", "asset_class": "equity", "sector": "Financials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000720005", "long_business_summary": "Raymond James Financial, Inc., a diversified financial services company, provides private client group, capital markets, asset management, banking, and other services to individuals, corporations, and municipalities in the United States, Canada, and Europe. The Private Client Group segment offers financial planning, investment advisory, securities transaction, investment services, portfolio management services, insurance and annuity products, and mutual funds; support to third-party mutual fund and annuity companies, including sales and marketing support, as well as distribution and accounting, and administrative services; margin loans; securities borrowing and lending services; and custodial, trade execution, research, and other support and services. The Capital Markets segment provides investment banking services, such as equity and debt underwriting, and merger and acquisition advisory; and fixed income and equity brokerage services. This segment also offers institutional sales, securities trading, equity research, and the syndication and management of investments in low-income housing funds and funds of a similar nature. The Asset Management segment provides asset management, portfolio management, and related administrative services to retail and institutional clients; and administrative support services, such as record-keeping. The Bank segment offers various types of loans, including securities-based, corporate, commercial and industrial, commercial real estate and construction, real estate investment trust, residential mortgage, and tax-exempt loans; Federal Deposit Insurance Corporation-insured deposit accounts; retail and corporate deposit; and liquidity management products and services. The Other segment engages in the private equity investments comprising investments in third-party funds. The company offers corporate, retail banking and trust services. Raymond James Financial, Inc. was founded in 1962 and is headquartered in Saint Petersburg, Florida.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-23", "eps_estimate_avg": 3.3276, "eps_estimate_num": 13, "eps_estimate_growth": 0.07, "eps_estimate_fwd": 14.05785, "revenue_estimate_avg": 4216641880.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:RJF", "quote": {"security_id": 692, "price": 177.68, "prev_close": 175.98, "change": 1.7, "change_pct": 0.966019, "day_open": 166.860001, "day_high": 179.29, "day_low": 175.925, "volume": 589686, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 10.53, "pe_ttm": 16.87}, "scores": {"id": 222, "security_id": 692, "as_of": "2026-07-27", "fundamental": 62.56, "technical": 80.3, "momentum": 93.46, "quality": 91.66, "risk": 85.18, "composite": 69.0, "pabrai": 74.1, "breakdown": {"fundamental": {"score": 62.56, "coverage": 0.75, "weight_present": 0.75, "metrics": {"roe": {"label": "Return on equity", "value": 0.176621, "sub_score": 70.65, "weight": 0.14, "contribution": 9.891}, "net_margin": {"label": "Net margin", "value": 0.154241, "sub_score": 77.12, "weight": 0.1, "contribution": 7.712}, "roa": {"label": "Return on assets", "value": 0.024938, "sub_score": 20.78, "weight": 0.08, "contribution": 1.6624}, "revenue_growth": {"label": "Revenue growth", "value": 0.095182, "sub_score": 55.77, "weight": 0.1, "contribution": 5.577}, "eps_growth": {"label": "EPS growth", "value": 0.059356, "sub_score": 39.84, "weight": 0.1, "contribution": 3.984}, "debt_to_equity": {"label": "Debt / equity", "value": 0.337519, "sub_score": 86.5, "weight": 0.1, "contribution": 8.65}, "fcf_margin": {"label": "Free-cash-flow margin