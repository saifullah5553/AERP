r both public and private sectors. Abdullah Al-Othaim Markets Company was founded in 1956 and is headquartered in Riyadh, the Kingdom of Saudi Arabia.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": null, "eps_estimate_avg": 0.03, "eps_estimate_num": 1, "eps_estimate_growth": null, "eps_estimate_fwd": 0.31551, "revenue_estimate_avg": 2577651000.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": null, "is_active": true, "market_code": "TADAWUL", "region": "gcc"}, "tradingview_symbol": "TADAWUL:4001", "quote": {"security_id": 1047, "price": 5.14, "prev_close": 5.07, "change": 0.07, "change_pct": 1.380671, "day_open": 5.15, "day_high": 5.16, "day_low": 5.07, "volume": 1244077, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 0.28, "pe_ttm": 18.36}, "scores": {"id": 576, "security_id": 1047, "as_of": "2026-07-27", "fundamental": 27.45, "technical": 14.92, "momentum": 8.96, "quality": 34.52, "risk": 40.56, "composite": 22.85, "pabrai": 55.4, "breakdown": {"fundamental": {"score": 27.45, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.192432, "sub_score": 76.97, "weight": 0.14, "contribution": 10.7758}, "net_margin": {"label": "Net margin", "value": 0.022554, "sub_score": 11.28, "weight": 0.1, "contribution": 1.128}, "roa": {"label": "Return on assets", "value": 0.033927, "sub_score": 28.27, "weight": 0.08, "contribution": 2.2616}, "gross_margin": {"label": "Gross margin", "value": 0.222181, "sub_score": 37.03, "weight": 0.06, "contribution": 2.2218}, "revenue_growth": {"label": "Revenue growth", "value": 0.030278, "sub_score": 37.22, "weight": 0.1, "contribution": 3.722}, "eps_growth": {"label": "EPS growth", "value": -0.508772, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 2.459658, "sub_score": 1.61, "weight": 0.1, "contribution": 0.161}, "current_ratio": {"label": "Current ratio", "value": 0.57364, "sub_score": 7.36, "wei