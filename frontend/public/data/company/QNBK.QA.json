dvisory, and brokerage and custody services. It serves the government, government agencies, individuals, and corporate sectors. The company was formerly known as Qatar National Bank S.A.Q. and changed its name to Qatar National Bank (Q.P.S.C.) in January 2016. The company was incorporated in 1964 and is based in Doha, Qatar."}, "tradingview_symbol": null, "quote": {"security_id": 1019, "price": 16.6, "prev_close": 16.5, "change": 0.1, "change_pct": 0.606063, "day_open": 16.5, "day_high": 16.75, "day_low": 16.49, "volume": 819228, "quoted_at": "2026-07-26T15:16:56.645004"}, "scores": {"id": 1018, "security_id": 1019, "as_of": "2026-07-26", "fundamental": 49.17, "technical": 16.85, "momentum": 37.47, "quality": 61.09, "risk": 80.45, "composite": 41.01, "pabrai": 40.9, "breakdown": {"fundamental": {"score": 49.17, "coverage": 0.75, "weight_present": 0.75, "metrics": {"roe": {"label": "Return on equity", "value": 0.144294, "sub_score": 57.72, "weight": 0.14, "contribution": 8.0808}, "net_margin": {"label": "Net margin", "value": 0.385539, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.012643, "sub_score": 10.54, "weight": 0.08, "contribution": 0.8432}, "revenue_growth": {"label": "Revenue growth", "value": 0.090693, "sub_score": 54.48, "weight": 0.1, "contribution": 5.448}, "eps_growth": {"label": "EPS growth", "value": 0.029586, "sub_score": 32.4, "weight": 0.1, "contribution": 3.24}, "debt_to_equity": {"label": "Debt / equity", "value": 0.850903, "sub_score": 65.96, "weight": 0.1, "contribution": 6.596}, "fcf_margin": {"label": "Free-cash-flow margin", "value": -0.834547, "sub_score": 0.0, "weight": 0.05, "contribution": 0.0}, "piotroski_f": {"label": "Piotroski F-Score", "value": 3.0, "sub_score": 33.33, "weight": 0.08, "contribution": 2.6664}}, "missing": ["gross_margin", "current_ratio", "interest_coverage", "altman_z"], "piotroski_criteria": {"positive_roa": true, "positive_ocf": false, "roa_improved": fal