{"security": {"id": 695, "market_id": 2, "symbol": "JBL", "provider_symbol": "JBL", "name": "Jabil Inc", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000898293", "long_business_summary": "Jabil Inc. provides engineering, manufacturing, and supply chain solutions worldwide. It operates in three segments: Regulated Industries, Intelligent Infrastructure, and Connected Living and Digital Commerce. The company offers electronic hardware, and embedded software design services for analog, digital, radio frequency, power, sensor, and optical component applications; creates, develops, and connects concepts and specifications that optimize the function, value, and appearance of products for both consumers and manufacturing partners; design of plastic and metal components, enclosures, sub-assemblies, and systems, with advanced modeling and analysis of electronic, electro-mechanical, and optical assemblies; detail design, environmental applications, thermal and tooling management; develop solutions for virtual and/or augmented reality, light detection and ranging, 3D sensing, projection, and imaging; delivering PCBA design with CAD tools; and electrical and mechanical assemblies. The company also offers cloud data center server platforms; medical and consumer health devices; automotive assemblies; a digital commerce ecosystem; and smart controls and security for digital building and utilities. In addition, the company offers systems assembly, test, direct-order fulfillment, and configure-to-order services. It serves 5G, wireless and cloud, digital print and retail, industrial and semi-cap, networking and storage, automotive and transportation, connected devices, healthcare and packaging, and mobility industries. Jabil Inc. was formerly known as Jabil Circuit, Inc. and changed its name to Jabil Inc. in June 2017. The company was founded in 1966 and is based in Saint Petersburg, Florida.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-09-24", "eps_estimate_avg": 4.06554, "eps_estimate_num": 9, "eps_estimate_growth": 0.2357, "eps_estimate_fwd": 16.74662, "revenue_estimate_avg": 9696629980.0, "eps_revisions_up_30d": 7, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:JBL", "quote": {"security_id": 695, "price": 308.52, "prev_close": 287.14, "change": 21.38, "change_pct": 7.445845, "day_open": 319.089996, "day_high": 309.14, "day_low": 296.57, "volume": 1242605, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 225, "security_id": 695, "as_of": "2026-07-27", "fundamental": 39.18, "technical": 41.94, "momentum": 47.91, "quality": 53.43, "risk": 32.03, "composite": 43.63, "pabrai": 56.4, "breakdown": {"fundamental": {"score": 39.18, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.404308, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.022046, "sub_score": 11.02, "weight": 0.1, "contribution": 1.102}, "roa": {"label": "Return on assets", "value": 0.036608, "sub_score": 30.51, "weight": 0.08, "contribution": 2.4408}, "gross_margin": {"label": "Gross margin", "value": 0.088786, "sub_score": 14.8, "weight": 0.06, "contribution": 0.888}, "revenue_growth": {"label": "Revenue growth", "value": 0.031818, "sub_score": 37.66, "weight": 0.1, "contribution": 3.766}, "eps_growth": {"label": "EPS growth", "value": -0.470899, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 2.224719, "sub_score": 11.01, "weight": 0.1, "contribution": 1.101}, "current_ratio": {"label": "Current ratio", "value": 1.000438, "sub_score": 50.04, "weight": 0.06, "contribution": 3.0024}, "interest_coverage": {"label": "Interest coverage", "value": 7.068027, "sub_score": 67.42, "weight": 0.06, "contrib