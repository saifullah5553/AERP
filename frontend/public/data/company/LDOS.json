e, surveillance, and reconnaissance missions; and provides space-based electro-optic infrared systems, multi/hyperspectral, electronic warfare and signals intelligence, and communications payloads. Leidos Holdings, Inc. was founded in 1969 and is headquartered in Reston, Virginia.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-04", "eps_estimate_avg": 2.88979, "eps_estimate_num": 14, "eps_estimate_growth": -0.0998, "eps_estimate_fwd": 13.11313, "revenue_estimate_avg": 4434626070.0, "eps_revisions_up_30d": 2, "eps_revisions_down_30d": 2, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:LDOS", "quote": {"security_id": 794, "price": 114.17, "prev_close": 112.41, "change": 1.76, "change_pct": 1.565697, "day_open": 112.010002, "day_high": 114.17, "day_low": 111.0, "volume": 446457, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 11.31, "pe_ttm": 10.09}, "scores": {"id": 324, "security_id": 794, "as_of": "2026-07-27", "fundamental": 71.66, "technical": 53.76, "momentum": 27.17, "quality": 72.39, "risk": 70.18, "composite": 61.82, "pabrai": 80.1, "breakdown": {"fundamental": {"score": 71.66, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.310463, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.084313, "sub_score": 42.16, "weight": 0.1, "contribution": 4.216}, "roa": {"label": "Return on assets", "value": 0.109271, "sub_score": 91.06, "weight": 0.08, "contribution": 7.2848}, "gross_margin": {"label": "Gross margin", "value": 0.180447, "sub_score": 30.07, "weight": 0.06, "contribution": 1.8042}, "revenue_growth": {"label": "Revenue growth", "value": 0.030729, "sub_score": 37.35, "weight": 0.1, "contribution": 3.735}, "eps_growth": {"label": "EPS growth", "value": 0.208333, "sub_score": 77.08, "weight": 0.1, "contribution": 7.708}, "debt_to_equity": {"label": "Debt / equity", "value": 1.06