{"security": {"id": 483, "market_id": 1, "symbol": "MSFT", "provider_symbol": "MSFT", "name": "Microsoft Corp", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000789019", "long_business_summary": "Microsoft Corporation develops and supports software, services, devices, and solutions worldwide. The Productivity and Business Processes segment offers Microsoft 365 commercial, enterprise mobility + security, windows commercial, power BI, exchange, sharepoint, Microsoft teams, security and compliance, and copilot; Microsoft 365 commercial products, such as Windows commercial on-premises and office licensed services; Microsoft 365 consumer products and cloud services, including Microsoft 365 consumer subscriptions, office licensed on-premises, and other consumer services; LinkedIn; dynamics products and cloud services, such as dynamics 365, cloud-based applications, and on-premises ERP and CRM applications. Its Intelligent Cloud segment provides Server products and cloud services comprising Azure and other cloud services, GitHub, Nuance Healthcare, virtual desktop offerings, and other cloud services; server products, including SQL and windows server, visual studio and system center related client access licenses, and other on-premises offerings; enterprise and partner services, such as enterprise support and nuance professional services, industry solutions, Microsoft partner network, and learning experience. The Personal Computing segment provides windows and devices, such as Windows OEM licensing and devices and surface and PC accessories; gaming services and solutions, such as Xbox hardware, content, and services, first- and third-party content Xbox game pass, subscriptions, and cloud gaming, advertising, and other cloud services; search and news advertising services. It sells its products through OEMs, distributors, and resellers; and online and retail stores. The company has a strategic collaboration with Mayo Clinic, Inc. for the development of a frontier AI model for healthcare; and Global Objects, Inc. to build a retrieval-grounded generative AI world model. The company was founded in 1975 and is headquartered in Redmond, Washington.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-30", "eps_estimate_avg": 4.23972, "eps_estimate_num": 30, "eps_estimate_growth": 0.1616, "eps_estimate_fwd": 19.37881, "revenue_estimate_avg": 87673343230.0, "eps_revisions_up_30d": 8, "eps_revisions_down_30d": 17, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:MSFT", "quote": {"security_id": 483, "price": 487.65, "prev_close": 464.72, "change": 22.93, "change_pct": 4.934154, "day_open": 387.049988, "day_high": 491.64, "day_low": 475.0, "volume": 61678582, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": null, "pe_ttm": null}, "scores": {"id": 13, "security_id": 483, "as_of": "2026-07-27", "fundamental": 79.85, "technical": 78.6, "momentum": 83.17, "quality": 69.31, "risk": 85.91, "composite": 80.33, "pabrai": 82.7, "breakdown": {"fundamental": {"score": 85.5, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.332808, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.36146, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.180048, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.688237, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.149322, "sub_score": 71.23, "weight": 0.1, "contribution": 7.123}, "eps_growth": {"label": "EPS growth", "value": 0.155143, "sub_score": 63.79, "weight": 0.1, "contribution": 6.379}, "debt_to_equity": {"label": "Debt / equity", "value": 0.176395, "su