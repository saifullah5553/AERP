ion, the company provides small package units, rooftop units, chillers, air handlers, and fan coils. It sells its products and services through direct sales, distributors, and company-owned parts and supplies stores. The company was founded in 1895 and is headquartered in Richardson, Texas.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-29", "eps_estimate_avg": 7.70378, "eps_estimate_num": 16, "eps_estimate_growth": -0.0149, "eps_estimate_fwd": 26.80771, "revenue_estimate_avg": 1564595400.0, "eps_revisions_up_30d": 3, "eps_revisions_down_30d": 2, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:LII", "quote": {"security_id": 936, "price": 412.49, "prev_close": 430.02, "change": -17.53, "change_pct": -4.076555, "day_open": 535.48999, "day_high": 433.14, "day_low": 411.405, "volume": 364424, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 466, "security_id": 936, "as_of": "2026-07-27", "fundamental": 69.37, "technical": 65.26, "momentum": 77.05, "quality": 77.75, "risk": 70.48, "composite": 71.07, "pabrai": 73.6, "breakdown": {"fundamental": {"score": 69.37, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.758329, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.155102, "sub_score": 77.55, "weight": 0.1, "contribution": 7.755}, "roa": {"label": "Return on assets", "value": 0.20925, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.333917, "sub_score": 55.65, "weight": 0.06, "contribution": 3.339}, "revenue_growth": {"label": "Revenue growth", "value": -0.027334, "sub_score": 20.76, "weight": 0.1, "contribution": 2.076}, "eps_growth": {"label": "EPS growth", "value": 0.009704, "sub_score": 27.43, "weight": 0.1, "contribution": 2.743}, "debt_to_equity": {"label": "Debt / equity", "value": 1.522397, "sub_score": 39.1, "