nd medium enterprises, financial institutions, and investment vehicles. Qatar Islamic Bank (Q.P.S.C.) was incorporated in 1982 and is headquartered in Doha, Qatar.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-22", "eps_estimate_avg": 0.50867, "eps_estimate_num": 2, "eps_estimate_growth": -0.058, "eps_estimate_fwd": 2.06048, "revenue_estimate_avg": 1707459380.0, "eps_revisions_up_30d": 1, "eps_revisions_down_30d": null, "is_active": true, "market_code": "QSE", "region": "gcc"}, "tradingview_symbol": null, "quote": {"security_id": 1049, "price": 21.86, "prev_close": 21.66, "change": 0.2, "change_pct": 0.923361, "day_open": 21.52, "day_high": 21.95, "day_low": 21.66, "volume": 912634, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 1.95, "pe_ttm": 11.21}, "scores": {"id": 578, "security_id": 1049, "as_of": "2026-07-27", "fundamental": 46.48, "technical": 53.17, "momentum": 66.11, "quality": 72.39, "risk": 83.76, "composite": 48.58, "pabrai": 61.7, "breakdown": {"fundamental": {"score": 46.48, "coverage": 0.75, "weight_present": 0.75, "metrics": {"roe": {"label": "Return on equity", "value": 0.149274, "sub_score": 59.71, "weight": 0.14, "contribution": 8.3594}, "net_margin": {"label": "Net margin", "value": 0.747155, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.022924, "sub_score": 19.1, "weight": 0.08, "contribution": 1.528}, "revenue_growth": {"label": "Revenue growth", "value": -0.021538, "sub_score": 22.42, "weight": 0.1, "contribution": 2.242}, "eps_growth": {"label": "EPS growth", "value": 0.048387, "sub_score": 37.1, "weight": 0.1, "contribution": 3.71}, "debt_to_equity": {"label": "Debt / equity", "value": 0.689334, "sub_score": 72.43, "weight": 0.1, "contribution": 7.243}, "fcf_margin": {"label": "Free-cash-flow margin", "value": -0.218378, "sub_score": 0.0, "weight": 0.05, "contribution": 0.0}, "piotroski_f": {"label": "Piotroski F-Score", "value": 2.0, "sub_