oreign exchange advisory; derivatives, such as currency, interest rate, and exchange-traded derivatives; debt capital markets, bullions, research, and online platforms; and correspondent and inclusive banking. IndusInd Bank Limited was incorporated in 1994 and is headquartered in Mumbai, India.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-15", "eps_estimate_avg": 8.71, "eps_estimate_num": 1, "eps_estimate_growth": 2.5254, "eps_estimate_fwd": 78.5437, "revenue_estimate_avg": 64092500000.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NSE", "region": "india"}, "tradingview_symbol": "NSE:INDUSINDBK", "quote": {"security_id": 1027, "price": 931.35, "prev_close": 900.0, "change": 31.35, "change_pct": 3.483333, "day_open": 1003.0, "day_high": 931.9, "day_low": 898.55, "volume": 3072018, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 38.4744, "pe_ttm": 24.21}, "scores": {"fundamental": 60.7, "technical": 59.73, "quality": 60.7, "risk": 72.61, "composite": 60.79}, "signal": {"signal_type": "hold", "label": "Hold", "signal_since": "2026-07-29", "signal_return_pct": -8.0, "price_at_signal": 1012.3}, "fundamentals": {"security_id": 1027, "as_of": "2026-03-31", "pe_ttm": 24.21, "roe": 0.04418355388302916, "debt_to_equity": 0.7918131599559489, "revenue_growth": 0.311582, "eps_growth": 4.942623, "net_margin": 0.1568207352441669, "dividend_yield": 0.0, "market_cap": null, "revenue_cagr_3y": -0.0848, "net_income_growth": 0.3108, "fcf_growth": -0.9828, "roa": 0.005173, "asset_turnover": 0.0317, "cfo_to_net_income": 1.3751, "fcf_margin": 0.5869673137721109, "fcf_to_net_income": 1.2953, "sales_cagr": -0.06948013070695092, "net_cagr": -0.2885527402161546, "eps_trend": 38.47435897435897, "tax_ratio": 0.1904068198985648, "total_debt": 537809000000.0, "cfo_trend": 119244000000.0, "net_change_cash": -104431000000.0, "cfo_vs_pat": 3.9734755081639452, "pe": 23.428590469843385, "earnings_yield": 0.0426828