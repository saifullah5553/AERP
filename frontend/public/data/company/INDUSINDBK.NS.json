{"security": {"id": 1027, "market_id": 5, "symbol": "INDUSINDBK", "provider_symbol": "INDUSINDBK.NS", "name": "IndusInd Bank", "asset_class": "equity", "sector": "Financial Services", "industry": null, "currency": "INR", "country": "IN", "isin": null, "figi": null, "cik": null, "long_business_summary": "IndusInd Bank Limited provides various banking products and financial services to individuals, corporations, government entities, and public sector undertakings in India. It operates in four segments: Treasury, Corporate/Wholesale Banking, Retail Banking, and Other Banking Operations. The company offers savings, salary, RFC, and uniformed personnel accounts; current accounts comprising smart, everyday, premium, trade, startup, and specialized accounts; fixed, recurring, sweep in/out, senior citizen fixed, NRE and NRO fixed, FCNR, and term deposits; vehicle, used and new car, two wheeler, home, gold, agri, personal, doctor professional, medical equipment, term, quick business, SME, and MSME loans; loans against property and securities; loans on credit card; and microfinance, working capital, and trade and export finance. It also provides debit, credit, prepaid, commercial, forex, duo, corporate, and business cards; life, health, and general insurance; safe deposit lockers; payment and financial inclusion products; foreign exchange services, including inward and outward remittances, and online forex portals; digital banking; and online vehicle auction services. In addition, the company offers mutual funds; bill payment; money transfer; NRI services; merchant solutions comprising POS terminal, payment gateway, digital rupee, and QR; transaction banking services, including trade finance, cash management, and tax payment; supply chain finance solutions, including supplier/vendor finance, channel finance, and receivable finance/factoring solutions; investment banking services consisting of debt syndication, debt and private equity fund-raising advisory, and M&A advisory; foreign exchange advisory; derivatives, such as currency, interest rate, and exchange-traded derivatives; debt capital markets, bullions, research, and online platforms; and correspondent and inclusive banking. IndusInd Bank Limited was incorporated in 1994 and is headquartered in Mumbai, India.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-15", "eps_estimate_avg": 8.71, "eps_estimate_num": 1, "eps_estimate_growth": 2.5254, "eps_estimate_fwd": 78.5437, "revenue_estimate_avg": 64092500000.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NSE", "region": "india"}, "tradingview_symbol": "NSE:INDUSINDBK", "quote": {"security_id": 1027, "price": 1011.0, "prev_close": 1011.45, "change": -0.45, "change_pct": -0.044491, "day_open": 1003.0, "day_high": 1017.9, "day_low": 996.4, "volume": 2922821, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 11.42, "pe_ttm": 88.53}, "scores": {"id": 556, "security_id": 1027, "as_of": "2026-07-27", "fundamental": 20.3, "technical": 73.57, "momentum": 89.81, "quality": 38.69, "risk": 72.61, "composite": 35.69, "pabrai": 34.6, "breakdown": {"fundamental": {"score": 20.3, "coverage": 0.75, "weight_present": 0.75, "metrics": {"roe": {"label": "Return on equity", "value": 0.013622, "sub_score": 5.45, "weight": 0.14, "contribution": 0.763}, "net_margin": {"label": "Net margin", "value": 0.035275, "sub_score": 17.64, "weight": 0.1, "contribution": 1.764}, "roa": {"label": "Return on assets", "value": 0.001621, "sub_score": 1.35, "weight": 0.08, "contribution": 0.108}, "revenue_growth": {"label": "Revenue growth", "value": -0.056522, "sub_score": 12.42, "weight": 0.1, "contribution": 1.242}, "eps_growth": {"label": "EPS growth", "value": -0.654672, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.650889, "sub_score": 73.96, "weight": 0.1, "contribution": 7.396}, "fcf_margin": {"label": "Free-cash-flow mar