nce using agentic AI systems. The company has a strategic alliance with ServiceNow for integrated risk management and third-party risk management solutions. Accenture plc was founded in 1951 and is based in Dublin, Ireland.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-09-24", "eps_estimate_avg": 3.17936, "eps_estimate_num": 20, "eps_estimate_growth": 0.0493, "eps_estimate_fwd": 14.68338, "revenue_estimate_avg": 18040245700.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 18, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:ACN", "quote": {"security_id": 579, "price": 170.43, "prev_close": 165.76, "change": 4.67, "change_pct": 2.817326, "day_open": 142.5, "day_high": 171.15, "day_low": 160.4, "volume": 5378402, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 12.29, "pe_ttm": 13.87}, "scores": {"id": 109, "security_id": 579, "as_of": "2026-07-27", "fundamental": 75.27, "technical": 63.85, "momentum": 40.96, "quality": 83.79, "risk": 72.58, "composite": 70.82, "pabrai": 78.0, "breakdown": {"fundamental": {"score": 75.27, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.258168, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.110207, "sub_score": 55.1, "weight": 0.1, "contribution": 5.51}, "roa": {"label": "Return on assets", "value": 0.126574, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.31914, "sub_score": 53.19, "weight": 0.06, "contribution": 3.1914}, "revenue_growth": {"label": "Revenue growth", "value": 0.073602, "sub_score": 49.6, "weight": 0.1, "contribution": 4.96}, "eps_growth": {"label": "EPS growth", "value": 0.06223, "sub_score": 40.56, "weight": 0.1, "contribution": 4.056}, "debt_to_equity": {"label": "Debt / equity", "value": 0.26231, "sub_score": 89.51, "weight": 0.1, "contribution": 8.951}, "curren