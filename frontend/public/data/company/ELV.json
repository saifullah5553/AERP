{"security": {"id": 586, "market_id": 2, "symbol": "ELV", "provider_symbol": "ELV", "name": "Elevance Health, Inc.", "asset_class": "equity", "sector": "Health Care", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001156039", "long_business_summary": "Elevance Health, Inc., together with its subsidiaries, operates as a health benefits company in the United States. The company operates in four segments: Health Benefits, CarelonRx, Carelon Services, and Corporate & Other. It offers a variety of health plans and services to individual, employer group risk-based and fee-based, BlueCard, Medicare, Medicaid, and FEP members; health products; a broad array of fee-based administrative managed care services; and specialty and other insurance products and services, such as stop loss, dental, vision, and supplemental health insurance benefits. The company also operates in the pharmacy services business; and markets and offers pharmacy services, including home delivery and specialty pharmacies, claims adjudication, formulary management, pharmacy networks, rebate administration, a prescription drug database, and member services, as well as infusion services and injectable therapies through ambulatory infusion centers. In addition, it provides healthcare related services and capabilities, including specialty care enablement and utilization management support for specialized clinical domains; behavioral health and comprehensive care management services; palliative care services and management; virtual care; and payment integrity, subrogation, clinical data exchange through its HealthOS platform, research and data, reporting and clinical analytics, information technology, and business process support services, as well as manages home health, post-acute institutional management, and durable medical equipment costs; and supports plans in managing home and community-based services. The company provides its services under the Anthem Blue Cross and Blue Shield, Wellpoint, and Carelon brands. The company was formerly known as Anthem, Inc. and changed its name to Elevance Health, Inc. in June 2022. Elevance Health, Inc. was incorporated in 2001 and is based in Indianapolis, Indiana.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-21", "eps_estimate_avg": 4.66488, "eps_estimate_num": 19, "eps_estimate_growth": -0.2264, "eps_estimate_fwd": 29.63423, "revenue_estimate_avg": 49121932460.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:ELV", "quote": {"security_id": 586, "price": 375.84, "prev_close": 376.4, "change": -0.56, "change_pct": -0.148778, "day_open": 380.559998, "day_high": 380.04, "day_low": 373.16, "volume": 692975, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 25.652, "pe_ttm": 14.65}, "scores": {"id": 116, "security_id": 586, "as_of": "2026-07-27", "fundamental": 42.9, "technical": 49.86, "momentum": 82.79, "quality": 41.44, "risk": 57.37, "composite": 51.32, "pabrai": 59.5, "breakdown": {"fundamental": {"score": 42.9, "coverage": 0.81, "weight_present": 0.81, "metrics": {"roe": {"label": "Return on equity", "value": 0.132915, "sub_score": 53.17, "weight": 0.14, "contribution": 7.4438}, "net_margin": {"label": "Net margin", "value": 0.028434, "sub_score": 14.22, "weight": 0.1, "contribution": 1.422}, "roa": {"label": "Return on assets", "value": 0.047503, "sub_score": 39.59, "weight": 0.08, "contribution": 3.1672}, "revenue_growth": {"label": "Revenue growth", "value": 0.126209, "sub_score": 64.63, "weight": 0.1, "contribution": 6.463}, "eps_growth": {"label": "EPS growth", "value": -0.024197, "sub_score": 18.95, "weight": 0.1, "contribution": 1.895}, "debt_to_equity": {"label": "Debt / equity", "value": 0.730277, "sub_score": 70.79, "weight": 0.1, "contribution": 7.079}, "interest_coverage": {"label": "Interest coverage", "value": 5.78602, "sub_score": 53.18, 