{"security": {"id": 862, "market_id": 2, "symbol": "NUE", "provider_symbol": "NUE", "name": "Nucor Corp", "asset_class": "equity", "sector": "Materials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000073309", "long_business_summary": "Nucor Corporation engages in the manufacture and sale of steel and steel products. The company operates in three segments: Steel Mills, Steel Products, and Raw Materials. The Steel Mills segment produces hot-rolled, cold-rolled, and galvanized sheet steel products; plate steel products; wide-flange beams, beam blanks, and H-piling and sheet piling structural steel products; and bar steel products, such as blooms, billets, concrete reinforcing and merchant bars, and engineered special bar quality products. This segment sells its products to steel service centers, fabricators, and manufacturers in the United States, Canada, and Mexico, as well as engages in the steel trading and rebar distribution businesses. The Steel Products segment offers steel joists and joist girders, steel decks, and galvanized torque tubes for use in solar arrays, hollow structural section steel tubing, electrical conduit, fabricated concrete reinforcing steel, cold finished steel, steel fasteners, steel grating and expanded metal, wire and wire mesh, metal building systems, insulated metal panels, steel racking, overhead doors, and utility towers and structures for communications and energy transmission. This segment is also involved in the piling distribution business. The Raw Materials segment produces direct reduced iron (DRI); brokers ferrous and nonferrous metals, pig iron, hot briquetted iron, and DRI; supplies ferro-alloys; processes ferrous and nonferrous scrap metal; and engages in the natural gas production and industrial gas business. This segment sells its ferrous scrap to electric arc furnace steel mills and foundries for manufacturing process; and nonferrous scrap metal to aluminum can producers, secondary aluminum smelters, steel mills and other processors, and consumers of various nonferrous metals. Nucor Corporation was founded in 1905 and is based in Charlotte, North Carolina.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-28", "eps_estimate_avg": 4.52584, "eps_estimate_num": 10, "eps_estimate_growth": 0.7078, "eps_estimate_fwd": 17.38468, "revenue_estimate_avg": 10129744030.0, "eps_revisions_up_30d": 5, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:NUE", "quote": {"security_id": 862, "price": 274.04, "prev_close": 261.28, "change": 12.76, "change_pct": 4.88365, "day_open": 242.339996, "day_high": 274.415, "day_low": 262.1, "volume": 1515819, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 7.53, "pe_ttm": 36.39}, "scores": {"id": 392, "security_id": 862, "as_of": "2026-07-27", "fundamental": 49.45, "technical": 91.95, "momentum": 95.79, "quality": 48.48, "risk": 83.45, "composite": 61.15, "pabrai": 54.2, "breakdown": {"fundamental": {"score": 49.45, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.084599, "sub_score": 33.84, "weight": 0.14, "contribution": 4.7376}, "net_margin": {"label": "Net margin", "value": 0.053671, "sub_score": 26.84, "weight": 0.1, "contribution": 2.684}, "roa": {"label": "Return on assets", "value": 0.050519, "sub_score": 42.1, "weight": 0.08, "contribution": 3.368}, "gross_margin": {"label": "Gross margin", "value": 0.119345, "sub_score": 19.89, "weight": 0.06, "contribution": 1.1934}, "revenue_growth": {"label": "Revenue growth", "value": 0.057266, "sub_score": 44.93, "weight": 0.1, "contribution": 4.493}, "eps_growth": {"label": "EPS growth", "value": -0.11098, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.340132, "sub_score": 86.39, "weight": 0.1, "contribution": 8.639}, "current_ratio": {"label": "Current r