ite of tools designed to help secure customers' online presence; and SSL certificates. The company serves small businesses, individuals, organizations, developers, designers, and domain investors. GoDaddy Inc. was founded in 1997 and is headquartered in Tempe, Arizona.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-31", "eps_estimate_avg": 1.6943, "eps_estimate_num": 12, "eps_estimate_growth": 0.2016, "eps_estimate_fwd": 8.97498, "revenue_estimate_avg": 1294529690.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:GDDY", "quote": {"security_id": 798, "price": 82.74, "prev_close": 99.33, "change": -16.59, "change_pct": -16.701903, "day_open": 89.019997, "day_high": 84.62, "day_low": 73.1, "volume": 6661734, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 6.34, "pe_ttm": 13.05}, "scores": {"id": 328, "security_id": 798, "as_of": "2026-07-27", "fundamental": 60.95, "technical": 24.73, "momentum": 30.93, "quality": 63.79, "risk": 22.1, "composite": 54.41, "pabrai": 80.2, "breakdown": {"fundamental": {"score": 57.27, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 1.929012, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.176728, "sub_score": 88.36, "weight": 0.1, "contribution": 8.836}, "roa": {"label": "Return on assets", "value": 0.107558, "sub_score": 89.63, "weight": 0.08, "contribution": 7.1704}, "gross_margin": {"label": "Gross margin", "value": 0.636141, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.082634, "sub_score": 52.18, "weight": 0.1, "contribution": 5.218}, "eps_growth": {"label": "EPS growth", "value": -0.043741, "sub_score": 14.06, "weight": 0.1, "contribution": 1.406}, "debt_to_equity": {"label": "Debt / equity", "value": 17.957229, "sub_score":