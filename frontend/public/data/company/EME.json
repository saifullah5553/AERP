d electrical; electrical panel design, fabrication, and installation; on-site repair and maintenance; and renewable energy services, as well as design, manufacturing, repair, and hydro blast cleaning services. The company was incorporated in 1987 and is headquartered in Norwalk, Connecticut.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-30", "eps_estimate_avg": 7.23108, "eps_estimate_num": 10, "eps_estimate_growth": 0.0761, "eps_estimate_fwd": 32.92597, "revenue_estimate_avg": 4710302750.0, "eps_revisions_up_30d": 5, "eps_revisions_down_30d": 2, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:EME", "quote": {"security_id": 689, "price": 813.495, "prev_close": 802.37, "change": 11.125, "change_pct": 1.386517, "day_open": 764.169983, "day_high": 839.99, "day_low": 804.95, "volume": 176614, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 219, "security_id": 689, "as_of": "2026-07-27", "fundamental": 79.76, "technical": 75.49, "momentum": 43.62, "quality": 68.99, "risk": 83.45, "composite": 74.63, "pabrai": 78.1, "breakdown": {"fundamental": {"score": 79.76, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.385025, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.074931, "sub_score": 37.47, "weight": 0.1, "contribution": 3.747}, "roa": {"label": "Return on assets", "value": 0.149674, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.193271, "sub_score": 32.21, "weight": 0.06, "contribution": 1.9326}, "revenue_growth": {"label": "Revenue growth", "value": 0.16616, "sub_score": 76.05, "weight": 0.1, "contribution": 7.605}, "eps_growth": {"label": "EPS growth", "value": 0.309579, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.12744, "sub_score": 94.9, "we