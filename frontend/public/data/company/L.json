{"security": {"id": 738, "market_id": 2, "symbol": "L", "provider_symbol": "L", "name": "Loews Corp", "asset_class": "equity", "sector": "Financials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000060086", "long_business_summary": "Loews Corporation, through its subsidiaries, provides commercial property and casualty insurance in the United States and internationally. The company offers specialty insurance products, such as management and professional liability and other coverage products; surety and fidelity bonds; professional liability coverages and risk management services to various professional firms, including architects, real estate agents, and accounting and law firms; standard and excess property, marine and boiler, machinery coverages, workers' compensation, general and product liability, commercial auto, umbrella, excess and surplus coverages, specialized loss-sensitive insurance programs, total risk management services relating to claim and information services; directors and officers, errors and omissions, employment practices, fiduciary, fidelity, and cyber coverages, as well as for small and mid-size firms, public and privately held firms, and not-for-profit organizations; and insurance products to serve the health care industry, including professional and general liability, as well as associated casualty coverage to aging services, allied medical facilities, dentists, physicians, nurses, and other medical practitioners. It also provides warranty and alternative risk, and run-off long-term care insurance products; ethane supply and transportation services for petrochemical customers, as well as transports and stores natural gas and natural gas liquids; operates a chain of hotels; develops, manufactures, and markets a range of extrusion blow-molded and injection molded plastic containers; and manufactures commodities and differentiated plastic resins. The company markets its insurance products and services through a network of retail and wholesale brokers, independent agents, brokers, and managing general underwriters. Loews Corporation was incorporated in 1969 and is headquartered in New York, New York.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-03", "eps_estimate_avg": null, "eps_estimate_num": null, "eps_estimate_growth": null, "eps_estimate_fwd": null, "revenue_estimate_avg": 0.0, "eps_revisions_up_30d": null, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:L", "quote": {"security_id": 738, "price": 116.37, "prev_close": 116.37, "change": 0.0, "change_pct": 0.0, "day_open": 114.459999, "day_high": 116.52, "day_low": 115.01, "volume": 86838, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 268, "security_id": 738, "as_of": "2026-07-27", "fundamental": 57.76, "technical": 85.55, "momentum": 82.5, "quality": 54.88, "risk": 88.92, "composite": 73.49, "pabrai": 64.8, "breakdown": {"fundamental": {"score": 57.76, "coverage": 0.81, "weight_present": 0.81, "metrics": {"roe": {"label": "Return on equity", "value": 0.093254, "sub_score": 37.3, "weight": 0.14, "contribution": 5.222}, "net_margin": {"label": "Net margin", "value": 0.091714, "sub_score": 45.86, "weight": 0.1, "contribution": 4.586}, "roa": {"label": "Return on assets", "value": 0.019811, "sub_score": 16.51, "weight": 0.08, "contribution": 1.3208}, "revenue_growth": {"label": "Revenue growth", "value": 0.054354, "sub_score": 44.1, "weight": 0.1, "contribution": 4.41}, "eps_growth": {"label": "EPS growth", "value": 0.24493, "sub_score": 86.23, "weight": 0.1, "contribution": 8.623}, "debt_to_equity": {"label": "Debt / equity", "value": 0.507813, "sub_score": 79.69, "weight": 0.1, "contribution": 7.969}, "interest_coverage": {"label": "Interest coverage", "value": 6.224256, "sub_score": 58.05, "weight": 0.06, "contribution": 3.483}, "fcf_margin": {"label": "Free-cash-flow margin", "value": 0.