tors. The company was formerly known as Roper Industries, Inc. and changed its name to Roper Technologies, Inc. in April 2015. Roper Technologies, Inc. was incorporated in 1981 and is based in Sarasota, Florida.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-22", "eps_estimate_avg": 5.78267, "eps_estimate_num": 14, "eps_estimate_growth": 0.125, "eps_estimate_fwd": 24.14484, "revenue_estimate_avg": 2172269420.0, "eps_revisions_up_30d": 1, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:ROP", "quote": {"security_id": 672, "price": 389.25, "prev_close": 408.07, "change": -18.82, "change_pct": -4.611954, "day_open": 362.234985, "day_high": 398.285, "day_low": 381.71, "volume": 1025774, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 202, "security_id": 672, "as_of": "2026-07-27", "fundamental": 54.0, "technical": 49.74, "momentum": 51.18, "quality": 66.19, "risk": 54.3, "composite": 54.18, "pabrai": 60.5, "breakdown": {"fundamental": {"score": 54.0, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.079295, "sub_score": 31.72, "weight": 0.14, "contribution": 4.4408}, "net_margin": {"label": "Net margin", "value": 0.194407, "sub_score": 97.2, "weight": 0.1, "contribution": 9.72}, "roa": {"label": "Return on assets", "value": 0.046617, "sub_score": 38.85, "weight": 0.08, "contribution": 3.108}, "gross_margin": {"label": "Gross margin", "value": 0.692439, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.122642, "sub_score": 63.61, "weight": 0.1, "contribution": 6.361}, "eps_growth": {"label": "EPS growth", "value": -0.011748, "sub_score": 22.06, "weight": 0.1, "contribution": 2.206}, "debt_to_equity": {"label": "Debt / equity", "value": 0.470251, "sub_score": 81.19, "weight": 0.1, "contribution": 8.119}, "current_ratio": {"label": "Current 