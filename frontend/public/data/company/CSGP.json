{"security": {"id": 804, "market_id": 1, "symbol": "CSGP", "provider_symbol": "CSGP", "name": "Costar Group, Inc.", "asset_class": "equity", "sector": "Real Estate", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001057352", "long_business_summary": "CoStar Group, Inc. provides information, analytics, and online marketplace services to real estate and related business communities in the United States, Australia, Canada, Europe, the Asia Pacific, and Latin America. It offers CoStar Property that provides inventory of office, industrial, retail, multifamily, hospitality, and student housing, and land properties; CoStar Leasing, a data on lease transactions and tools to manage user-entered lease data; CoStar Sales, a database of commercial real estate sales transactions; CoStar Owners provides detailed portfolio information; CoStar Markets to view and report on market and submarket trends; and CoStar Tenant that provides tenant information. The company also provides hospitality benchmarking that allows hotels to measure performance against competitors; Debt Solutions, a tool for lenders to manage loan portfolios and risk; and real estate and lease management technology solutions, such as lease administration, lease accounting, and transaction management services. In addition, it offers Apartamentos.com, an apartment marketing sites; LoopNet.com, a commercial property marketing sites; Homes.com, a home for sale listings site; Ten-X, an online auction platform for commercial real estate; Land.com, a marketplace for rural land sales; and BizBuySell.com, a marketplace for operating businesses and franchises for sale. It serves sales, leasing, and mortgage brokers; property, real estate investment trust, insurance companies, and asset managers; and government agencies, property owners, mortgage-backed security issuers, appraisers, design and construction professionals, pension fund managers, real estate developers, reporters tenant vendors, bankers, building services vendors, mortgage bankers, communications providers, retailers, institutional advisors, hospitality owners, investors, and real estate agents. The company was founded in 1986 and is headquartered in Arlington, Virginia.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-29", "eps_estimate_avg": 0.28603, "eps_estimate_num": 18, "eps_estimate_growth": 0.6825, "eps_estimate_fwd": 1.7756, "revenue_estimate_avg": 929378680.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:CSGP", "quote": {"security_id": 804, "price": 28.42, "prev_close": 27.66, "change": 0.76, "change_pct": 2.74765, "day_open": 27.280001, "day_high": 28.47, "day_low": 28.04, "volume": 150659, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 334, "security_id": 804, "as_of": "2026-07-27", "fundamental": 44.36, "technical": 11.12, "momentum": 9.62, "quality": 34.35, "risk": 74.17, "composite": 31.93, "pabrai": 44.6, "breakdown": {"fundamental": {"score": 44.36, "coverage": 0.94, "weight_present": 0.94, "metrics": {"roe": {"label": "Return on equity", "value": 0.000881, "sub_score": 0.35, "weight": 0.14, "contribution": 0.049}, "net_margin": {"label": "Net margin", "value": 0.002156, "sub_score": 1.08, "weight": 0.1, "contribution": 0.108}, "roa": {"label": "Return on assets", "value": 0.000707, "sub_score": 0.59, "weight": 0.08, "contribution": 0.0472}, "gross_margin": {"label": "Gross margin", "value": 0.788728, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.186769, "sub_score": 81.93, "weight": 0.1, "contribution": 8.193}, "eps_growth": {"label": "EPS growth", "value": -0.941176, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.142069, "sub_score": 94.32, "weight": 0.1, "contribution": 9.432}, "cu