me to Tata Consumer Products Limited in February 2020. Tata Consumer Products Limited was incorporated in 1962 and is based in Mumbai, India.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-24", "eps_estimate_avg": 4.77, "eps_estimate_num": 1, "eps_estimate_growth": 0.1663, "eps_estimate_fwd": 23.98384, "revenue_estimate_avg": 56488567000.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NSE", "region": "india"}, "tradingview_symbol": "NSE:TATACONSUM", "quote": {"security_id": 1029, "price": 1085.9, "prev_close": 1094.2, "change": -8.3, "change_pct": -0.758545, "day_open": 1115.099976, "day_high": 1098.9, "day_low": 1081.8, "volume": 897621, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 558, "security_id": 1029, "as_of": "2026-07-27", "fundamental": 62.26, "technical": 44.08, "momentum": 61.52, "quality": 56.58, "risk": 81.65, "composite": 57.59, "pabrai": 62.0, "breakdown": {"fundamental": {"score": 62.26, "coverage": 0.9, "weight_present": 0.9, "metrics": {"roe": {"label": "Return on equity", "value": 0.073814, "sub_score": 29.53, "weight": 0.14, "contribution": 4.1342}, "net_margin": {"label": "Net margin", "value": 0.076463, "sub_score": 38.23, "weight": 0.1, "contribution": 3.823}, "roa": {"label": "Return on assets", "value": 0.046433, "sub_score": 38.69, "weight": 0.08, "contribution": 3.0952}, "gross_margin": {"label": "Gross margin", "value": 0.395538, "sub_score": 65.92, "weight": 0.06, "contribution": 3.9552}, "revenue_growth": {"label": "Revenue growth", "value": 0.152053, "sub_score": 72.02, "weight": 0.1, "contribution": 7.202}, "debt_to_equity": {"label": "Debt / equity", "value": 0.129409, "sub_score": 94.82, "weight": 0.1, "contribution": 9.482}, "current_ratio": {"label": "Current ratio", "value": 1.561863, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "interest_coverage": {"label": "Interest coverage", "value": 16.856236, "sub_score": 100.0, "we