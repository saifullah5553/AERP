er generation and alternative energy systems, and electronic displays. Broadcom Inc. was founded in 1961 and is headquartered in Palo Alto, California.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-09-04", "eps_estimate_avg": 3.23823, "eps_estimate_num": 37, "eps_estimate_growth": 0.9161, "eps_estimate_fwd": 19.46067, "revenue_estimate_avg": 29435187950.0, "eps_revisions_up_30d": 25, "eps_revisions_down_30d": 9, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:AVGO", "quote": {"security_id": 485, "price": 389.435, "prev_close": 387.84, "change": 1.595, "change_pct": 0.411252, "day_open": 387.924988, "day_high": 399.92, "day_low": 379.71, "volume": 8954571, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 15, "security_id": 485, "as_of": "2026-07-27", "fundamental": 87.3, "technical": 57.69, "momentum": 54.36, "quality": 94.02, "risk": 47.04, "composite": 70.98, "pabrai": 62.1, "breakdown": {"fundamental": {"score": 87.3, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.310479, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.361983, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.137353, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.677665, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.238744, "sub_score": 96.78, "weight": 0.1, "contribution": 9.678}, "eps_growth": {"label": "EPS growth", "value": 2.866142, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.80126, "sub_score": 67.95, "weight": 0.1, "contribution": 6.795}, "current_ratio": {"label": "Current ratio", "value": 1.705358, "sub_score": 100.0, "weight": 0.06, "con