{"security": {"id": 923, "market_id": 1, "symbol": "HAS", "provider_symbol": "HAS", "name": "Hasbro, Inc.", "asset_class": "equity", "sector": "Consumer Discretionary", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000046080", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-22", "eps_estimate_avg": 1.84748, "eps_estimate_num": 11, "eps_estimate_growth": 0.0997, "eps_estimate_fwd": 6.52969, "revenue_estimate_avg": 1480144090.0, "eps_revisions_up_30d": 1, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NASDAQ", "region": "us", "long_business_summary": "Hasbro, Inc. operates as a toy and game company in the United States, Europe, Canada, Mexico, Latin America, Australia, China, and Hong Kong. The company offers trading cards and collectibles, action figures, arts and crafts and creative play products, dolls, play sets, preschool toys, plush products, vehicles and toy-related specialty products, sports action products and accessories, and other consumer products; and licensed products, such as apparel, publishing products, home goods and electronics, and toy products. It also engages in the sourcing, marketing, and sale of toy and game products; and promotes its brands through the out-licensing of trademarks, characters, and other brand and intellectual property rights to third parties through the sale of branded consumer products, such as toys and apparel. In addition, the company is involved in the promotion of its brands through the development of trading cards, role-playing, and digital game experiences based on Hasbro and Wizards of the Coast games; and license certain brands to other third-party digital game developers who transform Hasbro brand-based characters and other intellectual properties, into digital gaming experiences. Further, it develops and produces of Hasbro-branded entertainment content, including film, television, children's programming, digital content, and live entertainment. The company sells its products to retailers, distributors, wholesalers, discount stores, specialty hobby stores, drug stores, mail order houses, catalog stores, department stores, and other traditional retailers, as well as ecommerce retailers under the MAGIC: THE GATHERING, MONOPOLY, HASBRO GAMES, PLAY-DOH, TRANSFORMERS, DUNGEONS & DRAGONS, NERF, and PEPPA PIG, as well as LUCASFILMS' STAR WARS, BEYBLADE, Final Fantasy, The Lord of the Rings, Fallout, SPIDER-MAN, and THE AVENGERS brands. Hasbro, Inc. was founded in 1923 and is headquartered in Pawtucket, Rhode Island."}, "tradingview_symbol": "NASDAQ:HAS", "quote": {"security_id": 923, "price": 88.79, "prev_close": 87.1, "change": 1.69, "change_pct": 1.940299, "day_open": 87.43, "day_high": 89.0, "day_low": 87.25, "volume": 1572406, "quoted_at": "2026-07-26T14:47:41.084173"}, "scores": {"id": 923, "security_id": 923, "as_of": "2026-07-26", "fundamental": 26.53, "technical": 79.07, "momentum": 61.09, "quality": 26.11, "risk": 24.57, "composite": 48.14, "pabrai": 28.9, "breakdown": {"fundamental": {"score": 26.53, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": -0.380166, "sub_score": 0.0, "weight": 0.14, "contribution": 0.0}, "net_margin": {"label": "Net margin", "value": -0.068577, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "roa": {"label": "Return on assets", "value": -0.05422, "sub_score": 0.0, "weight": 0.08, "contribution": 0.0}, "gross_margin": {"label": "Gross margin", "value": 0.645821, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.136815, "sub_score": 67.66, "weight": 0.1, "contribution": 6.766}, "eps_growth": {"label": "EPS growth", "value": -1.830325, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 6.119777, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "current_ratio": {"label": "Current