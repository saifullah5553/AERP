{"security": {"id": 954, "market_id": 2, "symbol": "LYV", "provider_symbol": "LYV", "name": "Live Nation Entertainment, Inc.", "asset_class": "equity", "sector": "Communication Services", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001335258", "long_business_summary": "Live Nation Entertainment, Inc. operates as a live entertainment company worldwide. The company operates through Concerts, Ticketing, and Sponsorship & Advertising segments. Its Concerts segment promotes live music events in its owned or operated venues, and in rented third-party venues. This segment operates and manages music venues; produces music festivals; creates associated content; and offers management and other services to artists. The Ticketing segment manages the ticketing operations, including the provision of ticketing software and services to consumers with marketplace for tickets and event information through mobile apps, other websites, and retail outlets, as well as its websites, such as livenation.com and ticketmaster.com; and provides ticket resale services. This segment offers ticketing services for arenas, stadiums, amphitheaters, music clubs, concert promoters, professional sports franchises and leagues, college sports teams, performing arts venues, museums, and theaters. Its Sponsorship & Advertising segment sells international, national, and local sponsorships and placement of advertising, including signage, online advertising, and promotional programs; rich media offering, including advertising related with live streaming and music-related content; and ads through distribution network of venues, events, and websites. This segment also manages the development of strategic sponsorship programs, as well as develops, books, and produces custom events or programs for specific brands. It owns, operates, or leases entertainment venues. The company was formerly known as Live Nation, Inc. and changed its name to Live Nation Entertainment, Inc. in January 2010. Live Nation Entertainment, Inc. was incorporated in 2005 and is headquartered in Beverly Hills, California.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-31", "eps_estimate_avg": 0.5653, "eps_estimate_num": 12, "eps_estimate_growth": 0.3788, "eps_estimate_fwd": 2.15591, "revenue_estimate_avg": 7533123710.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 12, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:LYV", "quote": {"security_id": 954, "price": 174.13, "prev_close": 183.56, "change": -9.43, "change_pct": -5.137285, "day_open": 177.300003, "day_high": 187.2, "day_low": 171.0, "volume": 4291979, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": null, "pe_ttm": null}, "scores": {"id": 484, "security_id": 954, "as_of": "2026-07-27", "fundamental": 18.1, "technical": 57.92, "momentum": 80.03, "quality": 45.93, "risk": 36.42, "composite": 32.16, "pabrai": 64.2, "breakdown": {"fundamental": {"score": 34.47, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 2.23275, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.01968, "sub_score": 9.84, "weight": 0.1, "contribution": 0.984}, "roa": {"label": "Return on assets", "value": 0.023312, "sub_score": 19.43, "weight": 0.08, "contribution": 1.5544}, "gross_margin": {"label": "Gross margin", "value": 0.255464, "sub_score": 42.58, "weight": 0.06, "contribution": 2.5548}, "revenue_growth": {"label": "Revenue growth", "value": 0.088349, "sub_score": 53.81, "weight": 0.1, "contribution": 5.381}, "eps_growth": {"label": "EPS growth", "value": -1.086643, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 38.391577, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "current_ratio": {"label": "Current ratio", "value": 0.995062, "sub_score": 49.51, "weight": 0.06, "c