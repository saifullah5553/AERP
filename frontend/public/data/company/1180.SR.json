{"security": {"id": 1037, "market_id": 7, "symbol": "1180", "provider_symbol": "1180.SR", "name": "Saudi National Bank", "asset_class": "equity", "sector": "Financial Services", "industry": null, "currency": "SAR", "country": "SA", "isin": null, "figi": null, "cik": null, "long_business_summary": "The Saudi National Bank, through its subsidiaries, provides banking and investment management services in the Kingdom of Saudi Arabia and internationally. The company offers current, Al Wessam, gold, commercial enterprise, and corporate accounts; Shariah-compliant financing solutions, financial solutions to MSMEs, point-of-sale Merchant Financing, personal and lease finance, and residential finance; and corporate finance solutions, including Ijara, Musharaka financing, Project and Structured Finance, Syndications and Placements, and Tawarruq. It also provides deposit, prepaid, and credit cards; cash management services, such as dividend distribution, payroll, escrow account management, deposit, and debit services; guarantees, fleet leasing, investment products, and digital banking; treasury services, such as foreign currency exchange, money markets, and shariah compliant products; payments and transfers; and trade finance, including documentary collection, export and import letter of credit, letter of guarantees, documentary collection, letter of credit program for Saudi industrial development fund clients. In addition, it operates as a private equity fund; keeps and manages title deeds and collateralized real estate properties; trades in derivatives and repos/reverse repos activities; sells POS equipment and devices; manages liquidity, market, and credit risks; and provides recruitment services, safety deposit boxes, private banking services, wealth management, asset management, investment banking, and shares brokerage services, as well as correspondent banking products and services, including money market and foreign exchange. The company was formerly known as The National Commercial Bank and changed its name to The Saudi National Bank in April 2021. The Saudi National Bank was founded in 1950 and is headquartered in Riyadh, the Kingdom of Saudi Arabia.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": null, "eps_estimate_avg": 1.00705, "eps_estimate_num": 4, "eps_estimate_growth": -0.0317, "eps_estimate_fwd": 4.37398, "revenue_estimate_avg": 10315753340.0, "eps_revisions_up_30d": 1, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "TADAWUL", "region": "gcc"}, "tradingview_symbol": "TADAWUL:1180", "quote": {"security_id": 1037, "price": 40.86, "prev_close": 40.34, "change": 0.52, "change_pct": 1.289043, "day_open": 40.0, "day_high": 41.2, "day_low": 40.28, "volume": 6372295, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 4.04, "pe_ttm": 10.11}, "scores": {"id": 566, "security_id": 1037, "as_of": "2026-07-27", "fundamental": 61.97, "technical": 53.19, "momentum": 72.14, "quality": 64.29, "risk": 86.47, "composite": 60.8, "pabrai": 64.4, "breakdown": {"fundamental": {"score": 61.97, "coverage": 0.75, "weight_present": 0.75, "metrics": {"roe": {"label": "Return on equity", "value": 0.126379, "sub_score": 50.55, "weight": 0.14, "contribution": 7.077}, "net_margin": {"label": "Net margin", "value": 0.612412, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.021617, "sub_score": 18.01, "weight": 0.08, "contribution": 1.4408}, "revenue_growth": {"label": "Revenue growth", "value": 0.092029, "sub_score": 54.87, "weight": 0.1, "contribution": 5.487}, "eps_growth": {"label": "EPS growth", "value": 0.174419, "sub_score": 68.6, "weight": 0.1, "contribution": 6.86}, "debt_to_equity": {"label": "Debt / equity", "value": 0.655509, "sub_score": 73.78, "weight": 0.1, "contribution": 7.378}, "fcf_margin": {"label": "Free-cash-flow margin", "value": 0.140432, "sub_score": 93.62, "weight": 0.05, "contribution": 4.681}, "piotroski_f": {"label": "Piotroski