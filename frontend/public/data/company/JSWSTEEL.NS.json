{"security": {"id": 988, "market_id": 5, "symbol": "JSWSTEEL", "provider_symbol": "JSWSTEEL.NS", "name": "JSW Steel", "asset_class": "equity", "sector": "Materials", "industry": null, "currency": "INR", "country": "IN", "isin": null, "figi": null, "cik": null, "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-16", "eps_estimate_avg": 11.83, "eps_estimate_num": 1, "eps_estimate_growth": 0.7816, "eps_estimate_fwd": 72.85805, "revenue_estimate_avg": 467544528000.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NSE", "region": "india", "long_business_summary": "JSW Steel Limited manufactures and sells iron and steel products in India and internationally. The company offers hot and cold rolled steel products, colour coated sheets, galvanized and galvalume steel, electrical steel, steel doors, zinc-magnesium-aluminium products, aluminium-zinc roofing products, tin plate, TMT bars, wire rods, special alloy steel, grinding media, prepainted colour coated steel, low-carbon steel, hot-rolled sheets, structural steel, and low relaxation pre-stressed concrete steel strands under the JSW Neosteel, JSW Neostrands, JSW Neosteel Fastbuild, JSW Trusteel, JSW Colouron+, JSW Everglow, JSW Vishwas, JSW Platina, JSW Magsure, JSW Galveco, JSW Silveron+, JSW Pragati+, JSW Vishwas+, JSW Galvos, JSW Avante, JSW ColourFrame, JSW Endura+, JSW Radiance brands. It also engages in acquisition and investment in steel related and allied businesses, and trading in steel products; real estate; production and distribution of special long steel products; management of logistic infrastructure of Piombino's port area; produces forged steel balls; manufactures plates, pipes and double jointing, slabs, and hot rolled coils; produces gaseous and liquid form of oxygen, nitrogen, argon, and other products recoverable from separation of air; mining; and construction and development of residential township. In addition, the company trades in iron ore, steel, and allied activities; and provides steel plant, coke oven and pellet plant, power plant, and scrap shredding facilities. Its products are used in automotive, general engineering, machinery, and infrastructure and construction sectors. The company was formerly known as Jindal Vijayanagar Steel Limited and changed its name to JSW Steel Limited in June 2005. JSW Steel Limited was founded in 1982 and is based in Mumbai, India."}, "tradingview_symbol": "NSE:JSWSTEEL", "quote": {"security_id": 988, "price": 1240.800049, "prev_close": 1248.800049, "change": -8.0, "change_pct": -0.640615, "day_open": 1238.599976, "day_high": 1245.0, "day_low": 1228.099976, "volume": 1083729, "quoted_at": "2026-07-26T15:14:47.614922"}, "scores": {"id": 987, "security_id": 988, "as_of": "2026-07-26", "fundamental": 68.22, "technical": 53.58, "momentum": 65.73, "quality": 71.94, "risk": 62.11, "composite": 62.61, "pabrai": 70.4, "breakdown": {"fundamental": {"score": 68.22, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.248578, "sub_score": 99.43, "weight": 0.14, "contribution": 13.9202}, "net_margin": {"label": "Net margin", "value": 0.12259, "sub_score": 61.3, "weight": 0.1, "contribution": 6.13}, "roa": {"label": "Return on assets", "value": 0.087442, "sub_score": 72.87, "weight": 0.08, "contribution": 5.8296}, "gross_margin": {"label": "Gross margin", "value": 0.380022, "sub_score": 63.34, "weight": 0.06, "contribution": 3.8004}, "revenue_growth": {"label": "Revenue growth", "value": 0.092823, "sub_score": 55.09, "weight": 0.1, "contribution": 5.509}, "eps_growth": {"label": "EPS growth", "value": 5.366992, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "debt_to_equity": {"label": "Debt / equity", "value": 1.190159, "sub_score": 52.39, "weight": 0.1, "contribution": 5.239}, "current_ratio": {"label": "Current ratio", "value": 1.490912, "sub_score": 99.09, "weight": 0.06, "contribution": 5.9454}, "interes