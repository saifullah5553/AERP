{"security": {"id": 521, "market_id": 2, "symbol": "VZ", "provider_symbol": "VZ", "name": "Verizon Communications Inc", "asset_class": "equity", "sector": "Communication Services", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000732712", "long_business_summary": "Verizon Communications Inc., through its subsidiaries, engages in the provision of communications, technology, information, and streaming products and services to consumers, businesses, and governmental entities worldwide. It operates in two segments, Verizon Consumer Group (Consumer) and Verizon Business Group (Business). The Consumer segment provides wireless services across the wireless networks in the United States under the Verizon and TracFone brands and through wholesale and other arrangements; and fixed wireless access (FWA) broadband through its wireless networks, as well as related equipment and devices, such as smartphones, tablets, smartwatches, and other wireless-enabled connected devices. The segment also offers wireline services in the Mid-Atlantic and Northeastern United States, as well as Washington D.C. through its fiber-optic network, Verizon Fios product portfolio, and a copper-based network. The Business segment provides wireless and wireline communications services and products, including FWA and wireline broadband, advanced communication services, corporate networking, security and managed network, local and long-distance voice, and network access services to deliver various IoT services and products to businesses, government customers, and wireless and wireline carriers in the United States and internationally. The company distributes its products and services through direct channels, company-operated stores, digital and omnichannel platforms, indirect agents, business solution resellers, and national retailers. The company was formerly known as Bell Atlantic Corporation and changed its name to Verizon Communications Inc. in June 2000. Verizon Communications Inc. was incorporated in 1983 and is headquartered in New York, New York.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-20", "eps_estimate_avg": 1.29087, "eps_estimate_num": 15, "eps_estimate_growth": 0.0668, "eps_estimate_fwd": 5.26737, "revenue_estimate_avg": 34817747310.0, "eps_revisions_up_30d": 2, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:VZ", "quote": {"security_id": 521, "price": 46.485, "prev_close": 46.11, "change": 0.375, "change_pct": 0.813273, "day_open": 44.075001, "day_high": 46.515, "day_low": 45.47, "volume": 6234666, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 51, "security_id": 521, "as_of": "2026-07-27", "fundamental": 46.07, "technical": 46.76, "momentum": 58.99, "quality": 60.77, "risk": 42.63, "composite": 50.37, "pabrai": 56.9, "breakdown": {"fundamental": {"score": 46.07, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.168623, "sub_score": 67.45, "weight": 0.14, "contribution": 9.443}, "net_margin": {"label": "Net margin", "value": 0.124277, "sub_score": 62.14, "weight": 0.1, "contribution": 6.214}, "roa": {"label": "Return on assets", "value": 0.043535, "sub_score": 36.28, "weight": 0.08, "contribution": 2.9024}, "gross_margin": {"label": "Gross margin", "value": 0.589228, "sub_score": 98.2, "weight": 0.06, "contribution": 5.892}, "revenue_growth": {"label": "Revenue growth", "value": 0.025247, "sub_score": 35.78, "weight": 0.1, "contribution": 3.578}, "eps_growth": {"label": "EPS growth", "value": -0.021687, "sub_score": 19.58, "weight": 0.1, "contribution": 1.958}, "debt_to_equity": {"label": "Debt / equity", "value": 1.738876, "sub_score": 30.44, "weight": 0.1, "contribution": 3.044}, "current_ratio": {"label": "Current ratio", "value": 0.91265, "sub_score": 41.27, "weight": 0.06, "contribution": 2.4762}, "interest_coverage": {"label": "Int