xploring, drilling, processing, manufacturing, refining, extracting, and marketing hydrocarbon substances. The company was founded in 1933 and is headquartered in Dhahran, the Kingdom of Saudi Arabia.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-04", "eps_estimate_avg": 0.49933, "eps_estimate_num": 3, "eps_estimate_growth": 0.3185, "eps_estimate_fwd": 1.90855, "revenue_estimate_avg": 452701799900.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "TADAWUL", "region": "gcc"}, "tradingview_symbol": "TADAWUL:2222", "quote": {"security_id": 1033, "price": 26.6, "prev_close": 26.74, "change": -0.14, "change_pct": -0.52356, "day_open": 26.58, "day_high": 26.78, "day_low": 26.58, "volume": 6473217, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 1.44, "pe_ttm": 18.47}, "scores": {"id": 562, "security_id": 1033, "as_of": "2026-07-27", "fundamental": 75.38, "technical": 62.07, "momentum": 67.5, "quality": 72.84, "risk": 96.59, "composite": 71.73, "pabrai": 74.8, "breakdown": {"fundamental": {"score": 75.38, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.235943, "sub_score": 94.38, "weight": 0.14, "contribution": 13.2132}, "net_margin": {"label": "Net margin", "value": 0.208258, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.1399, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.501631, "sub_score": 83.61, "weight": 0.06, "contribution": 5.0166}, "revenue_growth": {"label": "Revenue growth", "value": -0.072416, "sub_score": 7.88, "weight": 0.1, "contribution": 0.788}, "eps_growth": {"label": "EPS growth", "value": -0.116564, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.243712, "sub_score": 90.25, "weight": 0.1, "contribution": 9.025}, "current_ratio": {"labe