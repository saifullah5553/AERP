es insurance products; letters of credit, letters of guarantee, and documentary and commercial letters of credit; foreign exchange and money market placement services; fund transfer services; Internet, mobile, and telephone banking services; and wealth management services, as well as merchant solutions. The Commercial Bank (P.S.Q.C.) was incorporated in 1974 and is based in Doha, Qatar."}, "tradingview_symbol": null, "quote": {"security_id": 1026, "price": 4.02, "prev_close": 4.03, "change": -0.01, "change_pct": -0.248145, "day_open": 4.05, "day_high": 4.053, "day_low": 4.02, "volume": 236365, "quoted_at": "2026-07-26T15:16:56.645004"}, "scores": {"id": 1025, "security_id": 1026, "as_of": "2026-07-26", "fundamental": 41.56, "technical": 15.29, "momentum": 37.18, "quality": 56.26, "risk": 71.47, "composite": 36.39, "pabrai": 63.0, "breakdown": {"fundamental": {"score": 41.56, "coverage": 0.75, "weight_present": 0.75, "metrics": {"roe": {"label": "Return on equity", "value": 0.082711, "sub_score": 33.08, "weight": 0.14, "contribution": 4.6312}, "net_margin": {"label": "Net margin", "value": 0.464749, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.012298, "sub_score": 10.25, "weight": 0.08, "contribution": 0.82}, "revenue_growth": {"label": "Revenue growth", "value": 0.014763, "sub_score": 32.79, "weight": 0.1, "contribution": 3.279}, "eps_growth": {"label": "EPS growth", "value": -0.295775, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 1.528379, "sub_score": 38.86, "weight": 0.1, "contribution": 3.886}, "fcf_margin": {"label": "Free-cash-flow margin", "value": 1.785266, "sub_score": 100.0, "weight": 0.05, "contribution": 5.0}, "piotroski_f": {"label": "Piotroski F-Score", "value": 4.0, "sub_score": 44.44, "weight": 0.08, "contribution": 3.5552}}, "missing": ["gross_margin", "current_ratio", "interest_coverage", "altman_z"], "piotroski_criteria": {"