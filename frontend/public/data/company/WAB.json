{"security": {"id": 920, "market_id": 2, "symbol": "WAB", "provider_symbol": "WAB", "name": "Westinghouse Air Brake Technologies Corp", "asset_class": "equity", "sector": "Industrials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000943452", "long_business_summary": "Westinghouse Air Brake Technologies Corporation provides locomotives, equipment, systems, and services for the freight rail and passenger transit industries worldwide. It operates in two segments, Freight and Transit. It offers diesel-electric and liquid natural gas-powered locomotives; engines, electric motors, and propulsion systems; and marine and mining products. The company also offers positive train control equipment; electronically controlled pneumatic braking products; railway electronics; signal design and engineering services; distributed locomotive power, and train cruise and remote controls; industrial/mobile Internet of Things hardware and software, edge-to-cloud, on and off-board analytics and rules, and asset performance management solutions; rail and shipper transportation management, and port visibility and optimization solutions; and network optimization solutions. In addition, it provides freight car trucks, braking equipment, and related components; air compressors and dryers, as well as heating, ventilation, and air conditioning (HVAC) systems; heat transfer components and systems; custom engineered burners and combustion systems; rail gear, signaling, and switch products; and turbochargers. Further, it offers freight locomotive overhauls, modernizations, and refurbishment; locomotive and car maintenance; transit locomotive and car overhaul; unit exchange of locomotive components; long-term parts arrangements; and way equipment maintenance services. Additionally, it provides railway and freight braking equipment and related components; brake shoes, discs, and pads; HVAC equipment; access and platform screen doors; pantographs; power converters and battery chargers; passenger information systems and closed-circuit television; signaling and railway electric relays; and doors, window assemblies, accessibility lifts, ramps, and electric charging solutions for buses. The company was founded in 1869 and is headquartered in Pittsburgh, Pennsylvania.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-21", "eps_estimate_avg": 2.72908, "eps_estimate_num": 10, "eps_estimate_growth": 0.1763, "eps_estimate_fwd": 12.37042, "revenue_estimate_avg": 3187900500.0, "eps_revisions_up_30d": 2, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:WAB", "quote": {"security_id": 920, "price": 292.46, "prev_close": 291.76, "change": 0.7, "change_pct": 0.239923, "day_open": 298.779999, "day_high": 295.965, "day_low": 287.75, "volume": 823212, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 450, "security_id": 920, "as_of": "2026-07-27", "fundamental": 54.69, "technical": 88.39, "momentum": 94.2, "quality": 55.7, "risk": 49.99, "composite": 70.77, "pabrai": 64.7, "breakdown": {"fundamental": {"score": 54.69, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.110206, "sub_score": 44.08, "weight": 0.14, "contribution": 6.1712}, "net_margin": {"label": "Net margin", "value": 0.104773, "sub_score": 52.39, "weight": 0.1, "contribution": 5.239}, "roa": {"label": "Return on assets", "value": 0.057394, "sub_score": 47.83, "weight": 0.08, "contribution": 3.8264}, "gross_margin": {"label": "Gross margin", "value": 0.340826, "sub_score": 56.8, "weight": 0.06, "contribution": 3.408}, "revenue_growth": {"label": "Revenue growth", "value": 0.075094, "sub_score": 50.03, "weight": 0.1, "contribution": 5.003}, "eps_growth": {"label": "EPS growth", "value": 0.130579, "sub_score": 57.64, "weight": 0.1, "contribution": 5.764}, "debt_to_equity": {"label": "Debt / equity", "value": 0.497307