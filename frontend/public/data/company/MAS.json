{"security": {"id": 859, "market_id": 2, "symbol": "MAS", "provider_symbol": "MAS", "name": "Masco Corp /De/", "asset_class": "equity", "sector": "Industrials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000062996", "long_business_summary": "Masco Corporation provides home improvement and building products in North America, Europe, and internationally. The company's Plumbing Products segment offers faucets, showerheads, handheld showers, valves, bath hardware and accessories, bathing units, shower bases and enclosures, shower drains, steam shower systems, water filtration systems, and sinks and kitchen accessories; acrylic tubs, bath and shower enclosures, and shower bases and trays; spas, exercise pools, and aquatic fitness systems and saunas; brass, copper, and composite plumbing system component and other non-decorative plumbing products; water products; and thermoplastic products, extruded plastic profiles, and specialized fabrication products, as well as PEX tubing products. This segment provides its products under the DELTA, BRIZO, PEERLESS, HANSGROHE, AXOR, KRAUS, NEWPORT BRASS, GINGER, WALTEC, BRISTAN, HERITAGE, MIROLIN, HOT SPRING, CALDERA, FREEFLOW SPAS, FANTASY SPAS, AQUATERRA, LIFESMART, ENDLESS POOLS, TYLO, FINNLEO, HELO, BRASSCRAFT, PLUMBSHOP, and MASTER PLUMBER brands, as well as under private label to home center and online retailers, mass merchandisers, wholesalers and distributors, plumbers, building contractors, remodelers, smaller retailers, and consumers and homebuilders. Its Decorative Architectural Products segment offers paints, primers, specialty coatings, stains, and waterproofing products, as well as paint applicators and accessories; cabinet and door hardware, functional hardware, hook and hook rail products, and outdoor living hardware; and decorative bath hardware, shower accessories, and shower doors. This segment provides its products under the BEHR, KILZ, WHIZZ, LIBERTY, and FRANKLIN BRASS brands to home center and other retailers, mass and online retailers, other specialty retailers, and original equipment manufacturers and wholesalers. The company was incorporated in 1929 and is headquartered in Livonia, Michigan.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-29", "eps_estimate_avg": 1.31117, "eps_estimate_num": 20, "eps_estimate_growth": 0.0086, "eps_estimate_fwd": 4.71216, "revenue_estimate_avg": 2085142480.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:MAS", "quote": {"security_id": 859, "price": 71.69, "prev_close": 72.11, "change": -0.42, "change_pct": -0.582443, "day_open": 77.550003, "day_high": 72.28, "day_low": 70.94, "volume": 1709235, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 389, "security_id": 859, "as_of": "2026-07-27", "fundamental": 56.11, "technical": 40.6, "momentum": 80.12, "quality": 51.24, "risk": 77.19, "composite": 55.39, "pabrai": 67.9, "breakdown": {"fundamental": {"score": 56.11, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": -3.476395, "sub_score": 0.0, "weight": 0.14, "contribution": 0.0}, "net_margin": {"label": "Net margin", "value": 0.107115, "sub_score": 53.56, "weight": 0.1, "contribution": 5.356}, "roa": {"label": "Return on assets", "value": 0.158559, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.354271, "sub_score": 59.05, "weight": 0.06, "contribution": 3.543}, "revenue_growth": {"label": "Revenue growth", "value": -0.033981, "sub_score": 18.86, "weight": 0.1, "contribution": 1.886}, "eps_growth": {"label": "EPS growth", "value": 0.024953, "sub_score": 31.24, "weight": 0.1, "contribution": 3.124}, "debt_to_equity": {"label": "Debt / equity", "value": -17.284946, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "current_ratio": {"label":