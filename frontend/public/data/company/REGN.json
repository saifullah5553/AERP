{"security": {"id": 604, "market_id": 1, "symbol": "REGN", "provider_symbol": "REGN", "name": "Regeneron Pharmaceuticals, Inc.", "asset_class": "equity", "sector": "Health Care", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000872589", "long_business_summary": "Regeneron Pharmaceuticals, Inc. discovers, invents, develops, manufactures, and commercializes medicines to treat various diseases worldwide. The company develops product candidates to treat eye, allergic and inflammatory, cardiovascular, metabolic, neurological, infectious, and rare diseases; and cancer, hematologic conditions. It also offers EYLEA injections for wet age-related macular degeneration and diabetic macular edema; myopic choroidal neovascularization; diabetic retinopathy; neovascular glaucoma; retinopathy of prematurity; Dupixent injection to treat atopic dermatitis and asthma; Libtayo injection for metastatic or locally advanced cutaneous squamous cell carcinoma; Praluent injection to treat heterozygous familial hypercholesterolemia (HoFH); and Kevzara solution for rheumatoid arthritis. It has license and collaboration agreement with Bayer for the development and commercialization of EYLEA 8 mg and EYLEA; Alnylam Pharmaceuticals, Inc. to discover, develop, and commercialize RNAi therapeutics for diseases by addressing therapeutic disease targets expressed in the eye and central nervous system; Intellia Therapeutics, Inc. to advance CRISPR/Cas9 gene-editing technology for in vivo therapeutic development for therapies focused on neurological and muscular diseases; Hansoh Pharmaceuticals Group Company Limited to acquire development and commercial rights for HS-20094, a dual GLP-1/GIP receptor; and Tessera Therapeutics, Inc. develops and commercializes TSRA-196, an investigational gene editing therapy for Alpha-1 antitrypsin deficiency. Additionally, the company has a strategic collaboration with Telix Pharmaceuticals Limited to develop and commercialize radiopharmaceutical therapies. It also has a strategic collaboration with CytomX Therapeutics, Inc. to create conditionally-activated bispecific cancer therapies. The company was incorporated in 1988 and is based in Tarrytown, New York.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-30", "eps_estimate_avg": 10.25622, "eps_estimate_num": 22, "eps_estimate_growth": -0.2043, "eps_estimate_fwd": 47.3967, "revenue_estimate_avg": 3824656370.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:REGN", "quote": {"security_id": 604, "price": 760.62, "prev_close": 759.24, "change": 1.38, "change_pct": 0.181761, "day_open": 658.289978, "day_high": 763.38, "day_low": 747.0, "volume": 379115, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": null, "pe_ttm": null}, "scores": {"id": 134, "security_id": 604, "as_of": "2026-07-27", "fundamental": 76.05, "technical": 80.0, "momentum": 74.95, "quality": 69.78, "risk": 98.01, "composite": 77.4, "pabrai": 74.8, "breakdown": {"fundamental": {"score": 74.81, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.148651, "sub_score": 59.46, "weight": 0.14, "contribution": 8.3244}, "net_margin": {"label": "Net margin", "value": 0.314086, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.115041, "sub_score": 95.87, "weight": 0.08, "contribution": 7.6696}, "gross_margin": {"label": "Gross margin", "value": 0.853537, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.009921, "sub_score": 31.41, "weight": 0.1, "contribution": 3.141}, "eps_growth": {"label": "EPS growth", "value": 0.053056, "sub_score": 38.26, "weight": 0.1, "contribution": 3.826}, "debt_to_equity": {"label": "Debt / equity", "value": 0.08657, "sub_score": 96.54, "weight": 0.1, "cont