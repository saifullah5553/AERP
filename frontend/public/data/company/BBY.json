, Inc. Best Buy Co., Inc. was incorporated in 1966 and is headquartered in Richfield, Minnesota.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-27", "eps_estimate_avg": 1.33955, "eps_estimate_num": 20, "eps_estimate_growth": 0.0465, "eps_estimate_fwd": 7.0717, "revenue_estimate_avg": 9521137630.0, "eps_revisions_up_30d": 12, "eps_revisions_down_30d": 6, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:BBY", "quote": {"security_id": 889, "price": 86.22, "prev_close": 85.25, "change": 0.97, "change_pct": 1.13783, "day_open": 83.849998, "day_high": 86.26, "day_low": 83.08, "volume": 1071056, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 5.06, "pe_ttm": 17.04}, "scores": {"id": 419, "security_id": 889, "as_of": "2026-07-27", "fundamental": 60.48, "technical": 90.56, "momentum": 96.71, "quality": 42.77, "risk": 73.53, "composite": 69.89, "pabrai": 67.8, "breakdown": {"fundamental": {"score": 60.48, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.370409, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.025641, "sub_score": 12.82, "weight": 0.1, "contribution": 1.282}, "roa": {"label": "Return on assets", "value": 0.072593, "sub_score": 60.49, "weight": 0.08, "contribution": 4.8392}, "gross_margin": {"label": "Gross margin", "value": 0.224821, "sub_score": 37.47, "weight": 0.06, "contribution": 2.2482}, "revenue_growth": {"label": "Revenue growth", "value": 0.003925, "sub_score": 29.69, "weight": 0.1, "contribution": 2.969}, "eps_growth": {"label": "EPS growth", "value": 0.174014, "sub_score": 68.5, "weight": 0.1, "contribution": 6.85}, "debt_to_equity": {"label": "Debt / equity", "value": 1.394399, "sub_score": 44.22, "weight": 0.1, "contribution": 4.422}, "current_ratio": {"label": "Current ratio", "value": 1.107436, "sub_score": 60.74, "weight": 0.06, "contribution": 3.6444}, "inter