{"security": {"id": 572, "market_id": 1, "symbol": "CDNS", "provider_symbol": "CDNS", "name": "Cadence Design Systems Inc", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000813672", "long_business_summary": "Cadence Design Systems, Inc. develops computational, AI-driven software, hardware, and silicon intellectual property products and solutions. The company offers functional verification services, such as Jasper, a formal verification platform; Xcelium, a parallel logic simulation platform; Verisium, a generative AI solution; Palladium, an enterprise emulation platform; and Protium, a prototyping platform for chip verification, as well as digital IC design and sign off products, including In novus platform; and custom IC design and simulation product include Virtuoso, a platform to design and verify analog. It also provides Xcelium logic simulator and other front-end verification and virtual prototyping technologies; controllers and physical interfaces; PCI Express, universal accelerator and compute express links, and multiple memory interfaces; and Ten Silica, a digital signal processor. In addition, the company's design IP portfolio includes serializer/deserializer, peripheral component interconnect, USB, and other standard protocols; and Secure-IC, a solution for embedded security IP. Additionally, it provides System Design and Analysis (SD&A) platform, a solution that enables end-to-end system-level design and verification across chips, packages, PCBs, and electronic systems; Allegro X and Orca X platforms for PCB and advanced packaging; Sigrity X for signal and power integrity; AIR for RF design; Fidelity for computational fluid dynamics; Celsius for thermal and airflow analysis; Clarity 3D solver for electromagnetic and power electronics analysis and simulation; Integrity 3D-IC solution for 3D-IC and multi-chiplet designs; the Optimality Intelligent System Explorer, Reality digital twin, and Millennium enterprise multiphasic platforms; Allegro system design platform; and molecular modeling and simulation solutions and services. The company has a strategic collaboration with NVIDIA. The company was incorporated in 1987 and is headquartered in San Jose, California.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-28", "eps_estimate_avg": 2.05529, "eps_estimate_num": 19, "eps_estimate_growth": 0.2456, "eps_estimate_fwd": 9.40326, "revenue_estimate_avg": 1576116340.0, "eps_revisions_up_30d": 8, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:CDNS", "quote": {"security_id": 572, "price": 339.015, "prev_close": 332.82, "change": 6.195, "change_pct": 1.861367, "day_open": 335.23999, "day_high": 344.77, "day_low": 334.249, "volume": 1165387, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 102, "security_id": 572, "as_of": "2026-07-27", "fundamental": 84.07, "technical": 42.99, "momentum": 43.86, "quality": 88.52, "risk": 76.3, "composite": 66.03, "pabrai": 71.7, "breakdown": {"fundamental": {"score": 84.07, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.218548, "sub_score": 87.42, "weight": 0.14, "contribution": 12.2388}, "net_margin": {"label": "Net margin", "value": 0.209352, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.115946, "sub_score": 96.62, "weight": 0.08, "contribution": 7.7296}, "gross_margin": {"label": "Gross margin", "value": 0.863643, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0}, "revenue_growth": {"label": "Revenue growth", "value": 0.141232, "sub_score": 68.92, "weight": 0.1, "contribution": 6.892}, "eps_growth": {"label": "EPS growth", "value": 0.051414, "sub_score": 37.85, "weight": 0.1, "contribution": 3.785}, "debt_to_equity": {"label": "Debt / equity", "value":