{"security": {"id": 524, "market_id": 1, "symbol": "MRVL", "provider_symbol": "MRVL", "name": "Marvell Technology, Inc.", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001835632", "long_business_summary": "Marvell Technology, Inc., together with its subsidiaries, provides data infrastructure semiconductor solutions and spanning the data center core to network edge in the United States, Argentina, China, India, Israel, Japan, Singapore, South Korea, Taiwan, Vietnam, and internationally. The company develops and scales system-on-a-chip architectures, integrating analog, mixed-signal, and digital signal processing functionality. It offers a portfolio of ethernet solutions, including spanning controllers, network adapters, physical transceivers, and switches; single or multiple core processors; and custom application specific integrated circuits, interconnects, fibre channel adapters, and processors. The company also provides interconnect products, including pulse amplitude modulation, coherent and coherent-lite digital signal processors (DSPs), laser drivers, trans-impedance amplifiers, silicon photonics, co-packaged optics, linear pluggable optics chipsets, data center interconnect, active electrical cable DSPs and peripheral component interconnect express retimer solutions; fibre channel products comprising host bus adapters and controllers for server and storage system connectivity; storage controllers for hard disk drives and solid-state-drives; host system interfaces, including serial advanced technology attachment and serial attached SCSI, peripheral component interconnect express, compute express link switches, non-volatile memory express (NVMe), and NVMe over fabrics; and develops ultra accelerator linkTM switches and ethernet for scale-up networking switches. The company serves data centers, communications, and other markets. It offers its products through direct customers and distributors. Marvell Technology, Inc. was incorporated in 1995 and is headquartered in Wilmington, Delaware.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-28", "eps_estimate_avg": 0.92727, "eps_estimate_num": 32, "eps_estimate_growth": 0.384, "eps_estimate_fwd": 6.24094, "revenue_estimate_avg": 2702565000.0, "eps_revisions_up_30d": 25, "eps_revisions_down_30d": 3, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:MRVL", "quote": {"security_id": 524, "price": 193.215, "prev_close": 183.3, "change": 9.915, "change_pct": 5.409165, "day_open": 202.910004, "day_high": 201.35, "day_low": 187.25, "volume": 19904573, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 54, "security_id": 524, "as_of": "2026-07-27", "fundamental": 88.9, "technical": 47.02, "momentum": 69.39, "quality": 89.23, "risk": 38.33, "composite": 67.96, "pabrai": 61.7, "breakdown": {"fundamental": {"score": 88.9, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.192541, "sub_score": 77.02, "weight": 0.14, "contribution": 10.7828}, "net_margin": {"label": "Net margin", "value": 0.325837, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.125682, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.510177, "sub_score": 85.03, "weight": 0.06, "contribution": 5.1018}, "revenue_growth": {"label": "Revenue growth", "value": 0.420873, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "eps_growth": {"label": "EPS growth", "value": 4.039216, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.334789, "sub_score": 86.61, "weight": 0.1, "contribution": 8.661}, "current_ratio": {"label": "Current ratio", "value": 2.006086, "sub_score": 100.0, "weight": 0.06, "contribution": 6.0},