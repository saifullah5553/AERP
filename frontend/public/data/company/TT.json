{"security": {"id": 556, "market_id": 2, "symbol": "TT", "provider_symbol": "TT", "name": "Trane Technologies Plc", "asset_class": "equity", "sector": "Industrials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001466258", "long_business_summary": "Trane Technologies plc designs, manufactures, sells, and services of solutions for heating, ventilation, air conditioning, and custom and transport refrigeration. It offers air conditioners, exchangers, and handlers; airside and terminal devices; air sourced heat pumps; chillers; coils and condensers; auxiliary power, cold storage, and condensing units; controls contracting and commissioning, decarbonization programs, and gensets; dehumidifiers; energy and water efficiency programs; energy recovery ventilators and power solutions; energy storage; furnaces; home automation; humidifiers; HVAC performance-monitoring products; and indoor air quality assessments and related products for HVAC and transport solutions. The company also provides asset management, building management, bus air purification, bus and rail HVAC, container refrigeration, control, ductless, geothermal, data center and multi-pipe HVAC, package heating and cooling, rail refrigeration, residential air filtration, self and vehicle powered truck refrigeration, temporary heating and cooling, truck refrigeration, unitary, variable refrigerant flow, and trailer refrigeration systems. In addition, it offers industrial process refrigeration, installation contracting, lighting retrofit, medical grade refrigeration, refrigerant reclamation, renewable energy and storage, residential hybrid heating, telematics, thermostats/controls and associated digital, ventilation, and stationary cold storage solutions; packaged rooftop units; rate chambers; residential air filters; thermal energy storage; transport heater products; temperature freezers; energy infrastructure programs and management, repair and maintenance, smart and AI-enabled, and rental services; water source heat pumps; and aftermarket and OEM parts and supplies. The company was formerly known as Ingersoll-Rand Plc and changed its name to Trane Technologies plc in March 2020. The company was founded in 1885 and is headquartered in Swords, Ireland.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-30", "eps_estimate_avg": 4.26108, "eps_estimate_num": 19, "eps_estimate_growth": 0.0982, "eps_estimate_fwd": 17.08899, "revenue_estimate_avg": 6196516210.0, "eps_revisions_up_30d": 1, "eps_revisions_down_30d": 3, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:TT", "quote": {"security_id": 556, "price": 454.95, "prev_close": 440.28, "change": 14.67, "change_pct": 3.331971, "day_open": 477.279999, "day_high": 459.49, "day_low": 450.51, "volume": 2203524, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 13.1782, "pe_ttm": 34.52}, "scores": {"id": 86, "security_id": 556, "as_of": "2026-07-27", "fundamental": 80.15, "technical": 38.67, "momentum": 75.19, "quality": 87.73, "risk": 78.5, "composite": 66.42, "pabrai": 79.2, "breakdown": {"fundamental": {"score": 80.15, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.363992, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.136883, "sub_score": 68.44, "weight": 0.1, "contribution": 6.844}, "roa": {"label": "Return on assets", "value": 0.140427, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.361609, "sub_score": 60.27, "weight": 0.06, "contribution": 3.6162}, "revenue_growth": {"label": "Revenue growth", "value": 0.07479, "sub_score": 49.94, "weight": 0.1, "contribution": 4.994}, "eps_growth": {"label": "EPS growth", "value": 0.151977, "sub_score": 62.99, "weight": 0.1, "contribution": 6.299}, "debt_to_equity": {"label": "Debt / equity", "value": 0.