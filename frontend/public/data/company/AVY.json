{"security": {"id": 835, "market_id": 2, "symbol": "AVY", "provider_symbol": "AVY", "name": "Avery Dennison Corp", "asset_class": "equity", "sector": "Materials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000008818", "long_business_summary": "Avery Dennison Corporation operates as a materials science and digital identification solutions company in the North America, Europe, the Middle East, North Africa, Asia, and Latin America. It offers pressure-sensitive label materials, which consist of papers, plastic films, and metal foils; performance tapes products, including mechanical fasteners, which are precision-extruded and injection-molded plastic devices; and other pressure-sensitive adhesive-based materials and converted products under the Fasson, JAC, and Avery Dennison brands. The company provides graphics and reflective products that include films and other products for the architectural, commercial sign, digital printing, and other related market segments; durable cast and reflective films to the construction, automotive, and fleet transportation markets; sign shops, commercial printers, and designers for pressure-sensitive materials; reflective films for traffic and safety applications; and pressure-sensitive vinyl and specialty materials for digital imaging, screen printing, and sign cutting applications under the Avery Dennison and Mactac brand names. In addition, it offers branding solutions, which include brand embellishments, graphic tickets, tags, labels, and sustainable packaging; information solutions, such as item-level RFID, visibility and loss prevention, price ticketing and marking, productivity and media, and brand protection and security solutions; and shelf-edge productivity and media solutions under the Vestcom brand names, as well as care, content, and country of origin compliance solutions. It serves home and personal care, apparel, general retail, e-commerce, logistics, food and grocery, pharmaceuticals, and automotive industries. The company was formerly known as Avery International Corporation and changed its name to Avery Dennison Corporation in 1990. The company was founded in 1935 and is headquartered in Mentor, Ohio.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-30", "eps_estimate_avg": 2.46999, "eps_estimate_num": 10, "eps_estimate_growth": 0.0207, "eps_estimate_fwd": 11.15316, "revenue_estimate_avg": 2296129410.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 6, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:AVY", "quote": {"security_id": 835, "price": 169.73, "prev_close": 174.82, "change": -5.09, "change_pct": -2.911566, "day_open": 155.690002, "day_high": 174.17, "day_low": 167.87, "volume": 963597, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": null, "pe_ttm": null}, "scores": {"id": 365, "security_id": 835, "as_of": "2026-07-27", "fundamental": 41.34, "technical": 61.23, "momentum": 73.84, "quality": 53.54, "risk": 34.1, "composite": 46.2, "pabrai": 69.2, "breakdown": {"fundamental": {"score": 55.11, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.302125, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.077692, "sub_score": 38.85, "weight": 0.1, "contribution": 3.885}, "roa": {"label": "Return on assets", "value": 0.079973, "sub_score": 66.64, "weight": 0.08, "contribution": 5.3312}, "gross_margin": {"label": "Gross margin", "value": 0.287539, "sub_score": 47.92, "weight": 0.06, "contribution": 2.8752}, "revenue_growth": {"label": "Revenue growth", "value": 0.011398, "sub_score": 31.83, "weight": 0.1, "contribution": 3.183}, "eps_growth": {"label": "EPS growth", "value": 0.013134, "sub_score": 28.28, "weight": 0.1, "contribution": 2.828}, "debt_to_equity": {"label": "Debt / equity", "value": 1.664912, "sub_score": 33.4, "weight": 0.1, "contributi