{"security": {"id": 834, "market_id": 2, "symbol": "ADM", "provider_symbol": "ADM", "name": "Archer-Daniels-Midland Co", "asset_class": "equity", "sector": "Consumer Staples", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000007084", "long_business_summary": "Archer-Daniels-Midland Company provides human and animal nutrition ingredients and solutions in the United States, Switzerland, the Cayman Islands, Brazil, Mexico, Canada, the United Kingdom, and internationally. It operates in three segments: Ag Services and Oilseeds; Carbohydrate Solutions; and Nutrition. The company engages in the origination, merchandising, transportation, and storage of agricultural raw materials, as well as the crushing and processing of oilseeds, including soybeans and soft seeds, such as cottonseed, sunflower seed, canola, rapeseed, and flaxseed; produces and markets vegetable oils and oilseed protein meals used by food, feed, energy, and industrial customers; sale of crude and partially refined vegetable oils; supplies peanuts and peanut-derived ingredients; and manufactures cotton cellulose pulp. It is also involved in the grain sourcing, handling, and multimodal transportation network supporting import, export, and distribution activities; structured trade finance activities; corn and wheat wet and dry milling and related processing activities; production of distillers' grains, corn gluten feed, and corn gluten meal for use as animal feed ingredients; and carbon capture and sequestration and other emissions-reduction initiatives. In addition, the company engages in the creation, manufacturing, sale, and distribution of an array of ingredients and solutions comprising plant-based proteins, flavors and colors derived from nature, flavor systems, emulsifiers, soluble fiber, polyols, hydrocolloids, probiotics, prebiotics, postbiotics, enzymes, botanical extracts, and other specialty food and feed ingredients and systems. Further, it is involved in the derivatives and commodity exchanges and clearing houses; and insurance coverage for certain property, casualty, marine, medical, and other miscellaneous risks. The company was founded in 1902 and is based in Chicago, Illinois.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-04", "eps_estimate_avg": 1.33635, "eps_estimate_num": 8, "eps_estimate_growth": 0.4369, "eps_estimate_fwd": 5.45572, "revenue_estimate_avg": 22748472610.0, "eps_revisions_up_30d": 2, "eps_revisions_down_30d": 2, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:ADM", "quote": {"security_id": 834, "price": 80.61, "prev_close": 80.38, "change": 0.23, "change_pct": 0.286141, "day_open": 86.610001, "day_high": 81.29, "day_low": 78.93, "volume": 2251056, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 364, "security_id": 834, "as_of": "2026-07-27", "fundamental": 21.99, "technical": 92.22, "momentum": 98.57, "quality": 13.91, "risk": 88.28, "composite": 60.75, "pabrai": 48.3, "breakdown": {"fundamental": {"score": 21.99, "coverage": 0.79, "weight_present": 0.79, "metrics": {"roe": {"label": "Return on equity", "value": 0.048017, "sub_score": 19.21, "weight": 0.14, "contribution": 2.6894}, "net_margin": {"label": "Net margin", "value": 0.01343, "sub_score": 6.71, "weight": 0.1, "contribution": 0.671}, "gross_margin": {"label": "Gross margin", "value": 0.062702, "sub_score": 10.45, "weight": 0.06, "contribution": 0.627}, "revenue_growth": {"label": "Revenue growth", "value": -0.061511, "sub_score": 11.0, "weight": 0.1, "contribution": 1.1}, "eps_growth": {"label": "EPS growth", "value": -0.403607, "sub_score": 0.0, "weight": 0.1, "contribution": 0.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.429244, "sub_score": 82.83, "weight": 0.1, "contribution": 8.283}, "interest_coverage": {"label": "Interest coverage", "value": 3.050654, "sub_score": 22.79, "weight": 0.06, "contribution": 1.3674}, "fcf_margin