{"security": {"id": 940, "market_id": 2, "symbol": "TDY", "provider_symbol": "TDY", "name": "Teledyne Technologies Inc", "asset_class": "equity", "sector": "Information Technology", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001094285", "long_business_summary": "Teledyne Technologies Incorporated provides enabling technologies for industrial growth markets in the United States, Europe, Asia, and internationally. The Digital Imaging segment provides visible spectrum sensors and digital cameras; and infrared, ultraviolet, visible, and X-ray spectrum products, as well as micro-electromechanical systems and semiconductors, such as analog-to-digital and digital-to-analog converters. This segment offers cooled and uncooled infrared or thermal products, including sensors, camera cores, and camera systems; high-resolution, low-dose X-ray sensors, high-power microwave, and high-energy X-ray subsystems; and instruments for the measurement of physical properties and maritime products, as well as develops and manufactures multi-spectrum electro-optic/infrared imaging systems and associated products, such as lasers, optics, radars, CBRNE (chemical, biological, radiological, nuclear, and explosive) detectors, and unmanned air and ground systems. The Instrumentation segment provides monitoring, control, and electronic test and measurement equipment; and power and communications connectivity devices for distributed instrumentation systems and sensor networks. The Aerospace and Defense Electronics segment offers electronic and optical components and subsystems, data acquisition and communications components and equipment, harsh-environment interconnects, general aviation batteries and other components; and onboard avionics systems and ground-based applications, aircraft data and connectivity solutions, hardware systems, and software applications. The Engineered Systems segment provides systems engineering, integration and advanced technology development, and complex manufacturing solutions for defense, space, environmental, and energy applications; and designs and manufactures electrochemical energy systems and specialty electronics for military applications. The company was founded in 1960 and is headquartered in Thousand Oaks, California.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-21", "eps_estimate_avg": 6.11679, "eps_estimate_num": 12, "eps_estimate_growth": 0.0982, "eps_estimate_fwd": 26.54013, "revenue_estimate_avg": 1648073930.0, "eps_revisions_up_30d": 1, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:TDY", "quote": {"security_id": 940, "price": 661.745, "prev_close": 649.18, "change": 12.565, "change_pct": 1.935519, "day_open": 653.73999, "day_high": 667.85, "day_low": 647.786, "volume": 217132, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 470, "security_id": 940, "as_of": "2026-07-27", "fundamental": 68.43, "technical": 84.39, "momentum": 72.6, "quality": 68.69, "risk": 83.76, "composite": 76.68, "pabrai": 62.2, "breakdown": {"fundamental": {"score": 68.43, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.089198, "sub_score": 35.68, "weight": 0.14, "contribution": 4.9952}, "net_margin": {"label": "Net margin", "value": 0.146319, "sub_score": 73.16, "weight": 0.1, "contribution": 7.316}, "roa": {"label": "Return on assets", "value": 0.060694, "sub_score": 50.58, "weight": 0.08, "contribution": 4.0464}, "gross_margin": {"label": "Gross margin", "value": 0.427576, "sub_score": 71.26, "weight": 0.06, "contribution": 4.2756}, "revenue_growth": {"label": "Revenue growth", "value": 0.078554, "sub_score": 51.02, "weight": 0.1, "contribution": 5.102}, "eps_growth": {"label": "EPS growth", "value": 0.104608, "sub_score": 51.15, "weight": 0.1, "contribution": 5.115}, "debt_to_equity": {"label": "Debt / equity", "value": 0.2512