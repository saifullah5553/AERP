{"security": {"id": 584, "market_id": 2, "symbol": "PSX", "provider_symbol": "PSX", "name": "Phillips 66", "asset_class": "equity", "sector": "Energy", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0001534701", "long_business_summary": "Phillips 66 operates as an integrated downstream energy provider in the United States, the United Kingdom, Germany, and internationally. It operates through five segments: Midstream, Chemicals, Refining, Marketing and Specialties (M&S), and Renewable Fuels. The Midstream segment provides crude oil and refined petroleum product transportation, terminaling, and storage services, as well as natural gas and natural gas liquids (NGL) gathering, processing, transportation, fractionation, storage and marketing services. It also exports liquefied petroleum gas. The Chemicals segment produces and markets ethylene and other olefin products; aromatics and styrenics products, such as benzene, cyclohexane, styrene, and polystyrene; various specialty chemical products, including organosulfur chemicals, solvents, catalysts, and chemicals used in drilling and mining; and petrochemicals and plastics. The Refining segment refines crude oil and other feedstocks into petroleum products, such as gasolines and distillates, including aviation fuels. The M&S segment purchases for resale and markets refined products, including gasolines, distillates, and aviation fuels. This segment also manufactures and markets specialty products, such as automotive, commercial, industrial, and specialty lubricants, as well as base oils. The Renewable Fuels segment processes renewable feedstocks into renewable products, as well as supplies sustainable aviation fuel. This segment also procures renewable feedstocks, manages certain regulatory credits, and markets renewable diesel, renewable jet fuel, and other renewable fuels. The company markets its products under the Phillips 66, Conoco and 76, JET, Kendall, Red Line, and other private label brands. Phillips 66 was founded in 1875 and is headquartered in Houston, Texas.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-05", "eps_estimate_avg": 7.50075, "eps_estimate_num": 18, "eps_estimate_growth": 2.1516, "eps_estimate_fwd": 18.86028, "revenue_estimate_avg": 44041423430.0, "eps_revisions_up_30d": 6, "eps_revisions_down_30d": 2, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:PSX", "quote": {"security_id": 584, "price": 206.3, "prev_close": 206.19, "change": 0.11, "change_pct": 0.053349, "day_open": 206.210007, "day_high": 206.815, "day_low": 200.6, "volume": 2084299, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 10.82, "pe_ttm": 19.07}, "scores": {"id": 114, "security_id": 584, "as_of": "2026-07-27", "fundamental": 55.4, "technical": 91.62, "momentum": 98.78, "quality": 34.95, "risk": 78.92, "composite": 65.86, "pabrai": 57.1, "breakdown": {"fundamental": {"score": 55.4, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.155856, "sub_score": 62.34, "weight": 0.14, "contribution": 8.7276}, "net_margin": {"label": "Net margin", "value": 0.033261, "sub_score": 16.63, "weight": 0.1, "contribution": 1.663}, "roa": {"label": "Return on assets", "value": 0.060207, "sub_score": 50.17, "weight": 0.08, "contribution": 4.0136}, "gross_margin": {"label": "Gross margin", "value": 0.098447, "sub_score": 16.41, "weight": 0.06, "contribution": 0.9846}, "revenue_growth": {"label": "Revenue growth", "value": -0.075283, "sub_score": 7.06, "weight": 0.1, "contribution": 0.706}, "eps_growth": {"label": "EPS growth", "value": 1.159681, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.677689, "sub_score": 72.89, "weight": 0.1, "contribution": 7.289}, "current_ratio": {"label": "Current ratio", "value": 1.296038, "sub_score": 79.6, "weight": 0.06, "contribution": 4.776}, "int