d investment activities under the Trammell Crow Company brand to users and investors in commercial real estate, and for their own account. CBRE Group, Inc. was founded in 1906 and is headquartered in Dallas, Texas.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-07-29", "eps_estimate_avg": 1.47158, "eps_estimate_num": 12, "eps_estimate_growth": 0.2366, "eps_estimate_fwd": 8.87445, "revenue_estimate_avg": 11280189200.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 4, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:CBRE", "quote": {"security_id": 664, "price": 146.81, "prev_close": 149.46, "change": -2.65, "change_pct": -1.77305, "day_open": 136.789993, "day_high": 150.485, "day_low": 144.87, "volume": 1829199, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 3.88, "pe_ttm": 37.84}, "scores": {"id": 194, "security_id": 664, "as_of": "2026-07-27", "fundamental": 48.16, "technical": 66.4, "momentum": 42.61, "quality": 40.93, "risk": 55.23, "composite": 54.99, "pabrai": 60.0, "breakdown": {"fundamental": {"score": 48.16, "coverage": 0.94, "weight_present": 0.94, "metrics": {"roe": {"label": "Return on equity", "value": 0.133842, "sub_score": 53.54, "weight": 0.14, "contribution": 7.4956}, "net_margin": {"label": "Net margin", "value": 0.028533, "sub_score": 14.27, "weight": 0.1, "contribution": 1.427}, "roa": {"label": "Return on assets", "value": 0.041875, "sub_score": 34.9, "weight": 0.08, "contribution": 2.792}, "gross_margin": {"label": "Gross margin", "value": 0.186584, "sub_score": 31.1, "weight": 0.06, "contribution": 1.866}, "revenue_growth": {"label": "Revenue growth", "value": 0.133727, "sub_score": 66.78, "weight": 0.1, "contribution": 6.678}, "eps_growth": {"label": "EPS growth", "value": 0.227848, "sub_score": 81.96, "weight": 0.1, "contribution": 8.196}, "debt_to_equity": {"label": "Debt / equity", "value": 1.125366, "sub_score": 54.99, "weight": 0.1, "contribution": 5.499}, "