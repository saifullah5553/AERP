 products; payments; general, accident, life, health, vehicle, and travel insurance products; cash management and merchant services; capital market and securities market services; and forex, derivatives, bullion, and bonds. The company was founded in 1955 and is headquartered in Mumbai, India.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-17", "eps_estimate_avg": 18.49, "eps_estimate_num": 1, "eps_estimate_growth": 0.0838, "eps_estimate_fwd": 94.0, "revenue_estimate_avg": 338900000000.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NSE", "region": "india"}, "tradingview_symbol": "NSE:ICICIBANK", "quote": {"security_id": 986, "price": 1590.0, "prev_close": 1571.5999755859375, "change": 18.400024, "change_pct": 1.170783, "day_open": 1435.699951, "day_high": 1592.5, "day_low": 1572.3, "volume": 16235799, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 81.4595, "pe_ttm": 19.52}, "scores": {"fundamental": 75.1, "technical": 61.31, "quality": 75.1, "risk": 88.13, "composite": 71.95}, "signal": {"signal_type": "buy", "label": "Buy", "signal_since": "2026-06-03", "signal_return_pct": 28.02, "price_at_signal": 1242.0}, "fundamentals": {"security_id": 986, "as_of": "2026-03-31", "pe_ttm": 19.52, "roe": 0.14399204495895104, "debt_to_equity": 0.7205206758664503, "revenue_growth": 0.110966, "eps_growth": 0.098136, "net_margin": 0.2784550363824506, "dividend_yield": 0.008194375529306606, "market_cap": null, "revenue_cagr_3y": 0.144, "net_income_growth": 0.0605, "fcf_growth": -0.5718, "roa": 0.018765, "asset_turnover": 0.0679, "cfo_to_net_income": -2.8525, "fcf_margin": -0.5882694587771631, "fcf_to_net_income": -2.9404, "sales_cagr": 0.17284246717848317, "net_cagr": 0.13706680034108776, "eps_trend": 81.45952282443801, "tax_ratio": 0.015534729066741044, "total_debt": 2955614000000.0, "cfo_trend": -1210546000000.0, "net_change_cash": 509573000000.0, "cfo_vs_pat": -2.049469833052011, "pe": 16.22523