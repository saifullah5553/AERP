{"security": {"id": 986, "market_id": 5, "symbol": "ICICIBANK", "provider_symbol": "ICICIBANK.NS", "name": "ICICI Bank", "asset_class": "equity", "sector": "Financial Services", "industry": null, "currency": "INR", "country": "IN", "isin": null, "figi": null, "cik": null, "long_business_summary": "ICICI Bank Limited, together with its subsidiaries, engages in the provision of various banking and financial services to corporate and retail customers in India and internationally. The company operates through Retail Banking, Wholesale Banking, Treasury, Other Banking, Life Insurance, General Insurance, and Others segments. The company offers asset management, securities brokerage, private equity, foreign exchange, agricultural and rural banking, equities underwriting, depositary share accounts, consumer durable goods financing, corporate salary and current account, savings and sovereign gold bonds, insurance policies, public offerings, investment, credit and protection, retail inward remittances, certificates of deposits, and payment and transaction banking products and services. It is also involved in the fee and commission-based activities; distribution of financial products; venture capital and real estate fund management business; treasury and rural banking operations; financial solutions; working capital financing; I-Process services, mutual funds, investment banking, and pension funds; and advisory activities. In addition, the company provides savings, salary, capital gains scheme, Hindu undivided family savings, real estate regulatory authority, government e-marketplace, current, trade, escrow, and foreign currency accounts. Further, it offers personal, home, car, education, gold, automobile, and commercial business loans, as well as loans against time deposits, securities, and property; and working capital loans, as well as credit, debit, prepaid, travel, forex, commercial, and corporate cards. Additionally, the company provides fixed income products; investment products; payments; general, accident, life, health, vehicle, and travel insurance products; cash management and merchant services; capital market and securities market services; and forex, derivatives, bullion, and bonds. The company was founded in 1955 and is headquartered in Mumbai, India.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-17", "eps_estimate_avg": 18.49, "eps_estimate_num": 1, "eps_estimate_growth": 0.0838, "eps_estimate_fwd": 94.0, "revenue_estimate_avg": 338900000000.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NSE", "region": "india"}, "tradingview_symbol": "NSE:ICICIBANK", "quote": {"security_id": 986, "price": 1445.7, "prev_close": 1432.9, "change": 12.8, "change_pct": 0.893293, "day_open": 1435.699951, "day_high": 1449.0, "day_low": 1428.8, "volume": 10607893, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 516, "security_id": 986, "as_of": "2026-07-27", "fundamental": 60.94, "technical": 83.55, "momentum": 94.61, "quality": 67.32, "risk": 88.13, "composite": 75.98, "pabrai": 68.9, "breakdown": {"fundamental": {"score": 60.94, "coverage": 0.75, "weight_present": 0.75, "metrics": {"roe": {"label": "Return on equity", "value": 0.160149, "sub_score": 64.06, "weight": 0.14, "contribution": 8.9684}, "net_margin": {"label": "Net margin", "value": 0.242641, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "roa": {"label": "Return on assets", "value": 0.019511, "sub_score": 16.26, "weight": 0.08, "contribution": 1.3008}, "revenue_growth": {"label": "Revenue growth", "value": 0.091307, "sub_score": 54.66, "weight": 0.1, "contribution": 5.466}, "eps_growth": {"label": "EPS growth", "value": 0.04806, "sub_score": 37.01, "weight": 0.1, "contribution": 3.701}, "debt_to_equity": {"label": "Debt / equity", "value": 0.571853, "sub_score": 77.13, "weight": 0.1, "contribution": 7.713}, "fcf_margin": {"label": "Free-cash-flow margin", "value": 0.284662, "sub_