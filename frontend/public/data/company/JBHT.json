{"security": {"id": 723, "market_id": 1, "symbol": "JBHT", "provider_symbol": "JBHT", "name": "Hunt J B Transport Services Inc", "asset_class": "equity", "sector": "Industrials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000728535", "long_business_summary": "J.B. Hunt Transport Services, Inc. provides surface transportation, delivery, and logistic services in the United States. It operates through five segments: Intermodal, Dedicated Contract Services, Integrated Capacity Solutions, Final Mile Services, and Truckload. The JBI segment offers intermodal freight solutions. It operates 124,838 pieces of company-owned trailing equipment; owns and maintains its chassis fleet of 104,474 units; and manages a fleet of 5,880 company-owned tractors, 308 independent contractor trucks, and 8,704 company drivers. The DCS segment designs, develops, and executes supply chain solutions that support various transportation networks. As of December 31, 2025, it operated 11,878 company-owned trucks, 761 customer-owned trucks, and a contractor trucks. It operates 26,767 owned pieces of trailing equipment and 5,218 customer-owned trailers. The ICS segment provides freight brokerage and transportation logistics solutions; flatbed, refrigerated, expedited, and less-than-truckload, as well as dry-van and intermodal solutions; online multimodal marketplace; and logistics management services for customers to outsource their transportation functions. The FMS segment delivers services through 1,085 company-owned trucks, 169 customer-owned trucks, and 39 independent contractor trucks; and 1,091 owned pieces of trailing equipment and 98 customer-owned trailers. The JBT segment provides dry-van freight services by utilizing tractors and trailers operating over roads and highways through two company-owned tractors and 12,658 company-owned trailers. It transports or arranges for the transportation of freight, such as general merchandise, specialty consumer items, appliances, home furnishings, forest, paper, rubber, plastic products, food, beverages, building materials, apparel, accessories, soaps, cosmetics, automotive parts, agricultural products, electronics, and chemicals. The company was incorporated in 1961 and is headquartered in Lowell, Arkansas.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-15", "eps_estimate_avg": 2.14017, "eps_estimate_num": 21, "eps_estimate_growth": 0.216, "eps_estimate_fwd": 10.11542, "revenue_estimate_avg": 3541932430.0, "eps_revisions_up_30d": 4, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NASDAQ", "region": "us"}, "tradingview_symbol": "NASDAQ:JBHT", "quote": {"security_id": 723, "price": 272.53, "prev_close": 269.21, "change": 3.32, "change_pct": 1.233238, "day_open": 289.369995, "day_high": 274.64, "day_low": 269.245, "volume": 391275, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 253, "security_id": 723, "as_of": "2026-07-27", "fundamental": 58.65, "technical": 50.62, "momentum": 97.92, "quality": 61.32, "risk": 80.93, "composite": 62.95, "pabrai": 55.5, "breakdown": {"fundamental": {"score": 58.65, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.157867, "sub_score": 63.15, "weight": 0.14, "contribution": 8.841}, "net_margin": {"label": "Net margin", "value": 0.049861, "sub_score": 24.93, "weight": 0.1, "contribution": 2.493}, "roa": {"label": "Return on assets", "value": 0.073683, "sub_score": 61.4, "weight": 0.08, "contribution": 4.912}, "gross_margin": {"label": "Gross margin", "value": 0.133062, "sub_score": 22.18, "weight": 0.06, "contribution": 1.3308}, "revenue_growth": {"label": "Revenue growth", "value": -0.007289, "sub_score": 26.49, "weight": 0.1, "contribution": 2.649}, "eps_growth": {"label": "EPS growth", "value": 0.114022, "sub_score": 53.51, "weight": 0.1, "contribution": 5.351}, "debt_to_equity": {"label": "Debt / equity", "value": 0.4114