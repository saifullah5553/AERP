{"security": {"id": 1028, "market_id": 5, "symbol": "APOLLOHOSP", "provider_symbol": "APOLLOHOSP.NS", "name": "Apollo Hospitals", "asset_class": "equity", "sector": "Healthcare", "industry": null, "currency": "INR", "country": "IN", "isin": null, "figi": null, "cik": null, "long_business_summary": "Apollo Hospitals Enterprise Limited, together with its subsidiaries, provides healthcare services in India. It operates through Healthcare Services, Retail Health & Diagnostics, Digital Health & Pharmacy Distribution, and Others segments. The company's healthcare facilities comprise primary, secondary, and tertiary care, as well as specialty facilities. It offers services in cardiac sciences, oncology, neurosciences, gastroenterology, orthopedics, urology, organ transplantation, pulmonology, obstetrics and gynecology, internal medicine, vascular surgery, pediatrics, cosmetology, emergency medicine, bariatric surgery, general surgery, colorectal surgery, dentistry, nephrology, dermatology, endocrinology, preventive medicine, interventional radiology, ophthalmology, and integrative medicine, as well as robotic surgery and genomics. The company also provides project consultancy, medical educational institutes, Medvarsity for e-learning, and research services, as well as acts as an agent for life, general, and health insurance. In addition, it operates hospitals, pharmacies, primary care clinics, and diagnostic centers; short stay facilities, boutique birthing centers, multi-specialty clinics, dental and dialysis facilities, and preventive care; day surgery, diabetes management, and cradle and fertility centers; and Apollo 24/7, a digital health mobile platform that provides teleconsultations, online pharmacy deliveries, home diagnostics, and insurance services. Further, the company engages in the business of bio-banking of tissues. It serves patients, corporate clients, and the government and public sectors. Apollo Hospitals Enterprise Limited was incorporated in 1979 and is based in Chennai, India.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-12", "eps_estimate_avg": 38.30609, "eps_estimate_num": 7, "eps_estimate_growth": 0.2726, "eps_estimate_fwd": 214.32825, "revenue_estimate_avg": 68924595740.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NSE", "region": "india"}, "tradingview_symbol": "NSE:APOLLOHOSP", "quote": {"security_id": 1028, "price": 8988.0, "prev_close": 8935.0, "change": 53.0, "change_pct": 0.593173, "day_open": 8816.0, "day_high": 9009.0, "day_low": 8865.5, "volume": 263010, "quoted_at": "2026-07-27T12:50:17.125760"}, "scores": {"id": 557, "security_id": 1028, "as_of": "2026-07-27", "fundamental": 69.49, "technical": 90.0, "momentum": 98.48, "quality": 68.22, "risk": 83.28, "composite": 81.15, "pabrai": 60.9, "breakdown": {"fundamental": {"score": 69.49, "coverage": 0.93, "weight_present": 0.93, "metrics": {"roe": {"label": "Return on equity", "value": 0.219495, "sub_score": 87.8, "weight": 0.14, "contribution": 12.292}, "net_margin": {"label": "Net margin", "value": 0.076965, "sub_score": 38.48, "weight": 0.1, "contribution": 3.848}, "roa": {"label": "Return on assets", "value": 0.090619, "sub_score": 75.52, "weight": 0.08, "contribution": 6.0416}, "gross_margin": {"label": "Gross margin", "value": 0.481713, "sub_score": 80.29, "weight": 0.06, "contribution": 4.8174}, "revenue_growth": {"label": "Revenue growth", "value": 0.157589, "sub_score": 73.6, "weight": 0.1, "contribution": 7.36}, "eps_growth": {"label": "EPS growth", "value": 0.34288, "sub_score": 100.0, "weight": 0.1, "contribution": 10.0}, "debt_to_equity": {"label": "Debt / equity", "value": 0.895866, "sub_score": 64.17, "weight": 0.1, "contribution": 6.417}, "current_ratio": {"label": "Current ratio", "value": 1.06457, "sub_score": 56.46, "weight": 0.06, "contribution": 3.3876}, "interest_coverage": {"label": "Interest coverage", "value": 6.918372, "sub_score": 65.76, "weight