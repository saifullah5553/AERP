{"security": {"id": 756, "market_id": 2, "symbol": "EFX", "provider_symbol": "EFX", "name": "Equifax Inc", "asset_class": "equity", "sector": "Industrials", "industry": null, "currency": "USD", "country": "US", "isin": null, "figi": null, "cik": "0000033185", "long_business_summary": "Equifax Inc. operates as a data, analytics, and technology company. The company operates through three segments: Workforce Solutions, U.S. Information Solutions (USIS), and International. The Workforce Solutions segment offers services that enables customers to verify income, employment, educational history, criminal justice data, healthcare professional licensure, and sanctions of people in the United States; and employer customers with services that that assist them in complying with and automating certain payroll-related and human resource management processes throughout the entire cycle of the employment relationship. The U.S. Information Solutions segment provides consumer and commercial information services, such as credit information and credit scoring, credit modeling and portfolio analytics, locate, fraud detection and prevention, identity verification, and other consulting services; mortgage services; financial marketing services; identity management services; and credit monitoring products. The International segment offers information service products, which include consumer and commercial services comprising credit and financial information, and credit scoring and modeling; and credit and other marketing products and services, as well as information, technology, and services to support debt collections and recovery management. The company also provides information solutions for businesses, governments and consumers; and human resources business process automation and outsourcing services for employers. It operates in Argentina, Australia, Brazil, Canada, Chile, Costa Rica, Dominican Republic, Ecuador, El Salvador, Honduras, India, Ireland, Mexico, New Zealand, Paraguay, Peru, Portugal, Spain, the United Kingdom, Uruguay, and the United States. The company was founded in 1899 and is headquartered in Atlanta, Georgia.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-10-20", "eps_estimate_avg": 2.22769, "eps_estimate_num": 19, "eps_estimate_growth": 0.092, "eps_estimate_fwd": 10.17016, "revenue_estimate_avg": 1700284250.0, "eps_revisions_up_30d": 0, "eps_revisions_down_30d": 1, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:EFX", "quote": {"security_id": 756, "price": 172.62, "prev_close": 176.13, "change": -3.51, "change_pct": -1.992846, "day_open": 165.550003, "day_high": 175.6, "day_low": 171.51, "volume": 835330, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 5.36, "pe_ttm": 32.21}, "scores": {"id": 286, "security_id": 756, "as_of": "2026-07-27", "fundamental": 54.03, "technical": 47.69, "momentum": 54.46, "quality": 59.56, "risk": 41.5, "composite": 54.12, "pabrai": 53.7, "breakdown": {"fundamental": {"score": 54.03, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.140471, "sub_score": 56.19, "weight": 0.14, "contribution": 7.8666}, "net_margin": {"label": "Net margin", "value": 0.1087, "sub_score": 54.35, "weight": 0.1, "contribution": 5.435}, "roa": {"label": "Return on assets", "value": 0.055902, "sub_score": 46.58, "weight": 0.08, "contribution": 3.7264}, "gross_margin": {"label": "Gross margin", "value": 0.564474, "sub_score": 94.08, "weight": 0.06, "contribution": 5.6448}, "revenue_growth": {"label": "Revenue growth", "value": 0.069247, "sub_score": 48.36, "weight": 0.1, "contribution": 4.836}, "eps_growth": {"label": "EPS growth", "value": 0.098361, "sub_score": 49.59, "weight": 0.1, "contribution": 4.959}, "debt_to_equity": {"label": "Debt / equity", "value": 1.106205, "sub_score": 55.75, "weight": 0.1, "contribution": 5.575}, "current_ratio": {"label": "Current ratio", "value": 0.604693, "sub_score"