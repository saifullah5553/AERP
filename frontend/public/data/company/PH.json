draulic valves and actuators, pneumatics, seals, sensors, and thermal management products. The company sells its products to original equipment manufacturers, distributors, direct-sales employees. Parker-Hannifin Corporation was founded in 1917 and is headquartered in Cleveland, Ohio.", "market_cap": null, "shares_outstanding": null, "next_earnings_date": "2026-08-06", "eps_estimate_avg": 8.27029, "eps_estimate_num": 21, "eps_estimate_growth": 0.0755, "eps_estimate_fwd": 34.11247, "revenue_estimate_avg": 5572335090.0, "eps_revisions_up_30d": 1, "eps_revisions_down_30d": null, "is_active": true, "market_code": "NYSE", "region": "us"}, "tradingview_symbol": "NYSE:PH", "quote": {"security_id": 549, "price": 991.235, "prev_close": 997.52, "change": -6.285, "change_pct": -0.630063, "day_open": 989.200012, "day_high": 1005.75, "day_low": 974.25, "volume": 278255, "quoted_at": "2026-07-27T12:50:17.125760", "eps_ttm": 27.52, "pe_ttm": 36.02}, "scores": {"id": 79, "security_id": 549, "as_of": "2026-07-27", "fundamental": 80.29, "technical": 83.64, "momentum": 85.18, "quality": 86.98, "risk": 81.86, "composite": 81.97, "pabrai": 73.9, "breakdown": {"fundamental": {"score": 80.29, "coverage": 1.0, "weight_present": 1.0, "metrics": {"roe": {"label": "Return on equity", "value": 0.27421, "sub_score": 100.0, "weight": 0.14, "contribution": 14.0}, "net_margin": {"label": "Net margin", "value": 0.177884, "sub_score": 88.94, "weight": 0.1, "contribution": 8.894}, "roa": {"label": "Return on assets", "value": 0.120118, "sub_score": 100.0, "weight": 0.08, "contribution": 8.0}, "gross_margin": {"label": "Gross margin", "value": 0.368514, "sub_score": 61.42, "weight": 0.06, "contribution": 3.6852}, "revenue_growth": {"label": "Revenue growth", "value": -0.004014, "sub_score": 27.42, "weight": 0.1, "contribution": 2.742}, "eps_growth": {"label": "EPS growth", "value": 0.243561, "sub_score": 85.89, "weight": 0.1, "contribution": 8.589}, "debt_to_equity": {"label": "Debt / equity", "value"